 <script>
      function handleBuyNowClick(e,productFormId){
         const selectedSize = document.querySelector('.product-parameters input[name="Size"]:checked');
         // Remove any existing warning message
        const existingWarning = document.querySelector('.size-warning');
        if (existingWarning) existingWarning.remove();
        if (selectedSize) {
          onBuyNowClick(e, productFormId);
        } else {
          const sizeOptionsContainer = document.querySelector('.product-parameters input[name="Size"]').closest('.product-form__controls-group');

          const warningDiv = document.createElement('div');
          warningDiv.className = 'size-warning';
          warningDiv.style.color = 'red';
          warningDiv.style.marginTop = '8px';
          warningDiv.textContent = 'Please select a size.';

          sizeOptionsContainer.appendChild(warningDiv);
          return;
        }
      }
    </script>
    <script>
      function observeSizeSelection() {
      const sizeContainer = document.querySelector('.product-parameters');

      if (!sizeContainer) return;

      const observer = new MutationObserver(() => {
        const selectedSize = document.querySelector('.product-parameters input[name="Size"]:checked');
        const warning = document.querySelector('.size-warning');

        if (selectedSize && warning) {
          warning.remove();
        }
      });

      observer.observe(sizeContainer, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['checked']
      });
    }
    document.addEventListener('DOMContentLoaded', function () {
    observeSizeSelection();
  });
    </script>
