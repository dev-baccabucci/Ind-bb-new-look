    <script>
document.addEventListener("DOMContentLoaded", () => {
  const wishlistKey = "shopify_wishlist";

  // Make functions globally accessible
  window.updateWishlistCount = function() {
    const wishlist = JSON.parse(localStorage.getItem(wishlistKey)) || [];
    const countElement = document.getElementById("wishlist-count");
    if (countElement) {
      countElement.textContent = wishlist.length;
    }
  };

  window.updateWishlistButtonState = function() {
    const wishlist = JSON.parse(localStorage.getItem(wishlistKey)) || [];
    document.querySelectorAll(".wishlist-button").forEach(button => {
      const productHandle = button.dataset.productHandle;
      const wishlistAction = button.querySelector(".wishlist-action");
      const wishlistIcon = button.querySelector(".wishlist-icon");

      if (wishlist.includes(productHandle)) {
        wishlistAction.textContent = "";
        wishlistIcon.src = "https://cdn.shopify.com/s/files/1/0279/5133/3450/files/heart_fill.png?v=1787205694";
        button.classList.add("in-wishlist");
      } else {
        wishlistAction.textContent = "";
        wishlistIcon.src = "https://cdn.shopify.com/s/files/1/0279/5133/3450/files/heart.png?v=1733812785";
        button.classList.remove("in-wishlist");
      }
    });
    updateWishlistCount();
  };

  function sendToCleverTap(eventData) {
    if (window.clevertap) {
      clevertap.event.push("Wishlist", eventData);
      console.log("CleverTap Event Sent: Wishlist", eventData);
    } else {
      console.warn("CleverTap not initialized.");
    }
  }

  // Make function globally accessible
  window.toggleWishlist = function(button) {
    const productHandle = button.dataset.productHandle;
    const productName = button.dataset.productName;
    const productImage = button.dataset.productImage;
    const productPrice = button.dataset.productPrice;

    let wishlist = JSON.parse(localStorage.getItem(wishlistKey)) || [];

    if (wishlist.includes(productHandle)) {
      wishlist = wishlist.filter(handle => handle !== productHandle);
      localStorage.setItem(wishlistKey, JSON.stringify(wishlist));
      alert("Product removed from wishlist.");
    } else {
      wishlist.push(productHandle);
      localStorage.setItem(wishlistKey, JSON.stringify(wishlist));
      alert("Product added to wishlist.");

      const eventData = { productHandle, productName, productImage, productPrice };
      sendToCleverTap(eventData);
    }
    updateWishlistButtonState();
  };

  updateWishlistButtonState(); // Update UI on load

  // Remove direct click listeners, use event delegation instead
  document.addEventListener("click", (event) => {
    const button = event.target.closest(".wishlist-button");
    if (button) {
      toggleWishlist(button);
    }
  });

  //  Attach observer only when recommendations section exists
  const recommendationsSection = document.querySelector(".product-recommendations");
  if (recommendationsSection) {
    const observer = new MutationObserver(() => {
      updateWishlistButtonState();
    });
    observer.observe(recommendationsSection, { childList: true, subtree: true });
  }

});
</script>

{% render 'kwikpass' %} 

  </body>
</html>
