    <script>
  (function () {
    const botPattern = /bot|crawl|slurp|spider/i;
    if (botPattern.test(navigator.userAgent)) return;

    if (sessionStorage.getItem("geo_redirect_done")) return;

    fetch("https://ipinfo.io/json")
      .then(res => res.json())
      .then(data => {
        console.log("ipinfo.io result:", data);
        if (data && data.country === "AE") {
          sessionStorage.setItem("geo_redirect_done", "true");
          const path = window.location.pathname + window.location.search;
          const redirectTo = "https://baccabucci.ae" + path;
          console.log("Redirecting to:", redirectTo);
          window.location.href = redirectTo;
        }
      })
      .catch(err => console.error("Geo fetch failed:", err));
  })();
</script> 

