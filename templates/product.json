0;\n    font-size: 13px;\n    font-family: Lato;\n    text-transform: uppercase;\n}\n.customfield-btn a {\n       border: 1px solid rgb(var(--color-border));\n    border-radius: 6px;\n    padding: 5px 10px;\n    display: inline-block;\n    margin: 3px 0;\n    text-decoration: none;\n}\n.customfield-btn a.first-btn {\n    border-color: #000; /* <<< 1st button different color */\n}\n.new-btn-section {\n    padding-top: 10px;\n}\n\n@media screen and (max-width: 569px) {\n .button-textcst {\n    font-size: 1.2rem;\n}\n}\n</style>"
