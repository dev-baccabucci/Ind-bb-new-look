{"sections":{"main":{"type":"main-page","disabled":true,"custom_css":["@media screen and (min-width: 1200px) {h1.heading span {font-size: 40px; }}"],"settings":{"padding_top":"no-indent","padding_bottom":"m"}},"custom_slideshow_adETfb":{"type":"custom-slideshow","blocks":{"slide_CBcLKf":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/colossus_per_order_banner_desktop_2.jpg","image1":"shopify:\/\/shop_images\/Group_1597881180_1_-min.png","button_link":"#prefeature"}}},"block_order":["slide_CBcLKf"],"name":"Custom Slideshow","settings":{}},"custom_liquid_p4BzxM":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div class=\"marquee\">\n  <div class=\"marquee-track\">\n    <div class=\"marquee-content\">&nbsp;PREMIUM DESIGN FOR YOU - PREORDER NOW - PREMIUM DESIGN FOR YOU - PREORDER NOW - PREMIUM DESIGN FOR YOU - PREORDER NOW - PREMIUM DESIGN FOR YOU - PREORDER NOW \n        - PREMIUM DESIGN FOR YOU - PREORDER NOW - PREMIUM DESIGN FOR YOU - PREORDER NOW \n    <\/div>\n  <\/div>\n<\/div>\n<style>\n.marquee {\n  position: relative;\n  width: 100vw;\n  max-width: 100%;\n  height: 70px;\n  overflow-x: hidden;\n  color: black;\n  font-size: 60px;\n  font-weight: bold;\n  opacity: 0.4;\n  color: #e0a435;\n        display: flex;\n        align-items: center;\nbackground:antiquewhite;\n}\n\n.marquee-track {\n  position: absolute;\n  display: inline-block;\n  white-space: nowrap;\n  will-change: transform;\n  animation: marquee 35s linear infinite;\n}\n@media (max-width: 768px) {\n.marquee {\n  font-size: 40px;\n    height: 62px;\n}\n}\n\n@keyframes marquee {\n  from { transform: translateX(0); }\n  to { transform: translateX(-50%); }\n}\n\n<\/style>"}},"countdown_preorder_hKaTnz":{"type":"countdown-preorder","name":"Countdown Preorder","settings":{"color_scheme":"","content_color_scheme":"background-1","gap":"small","content_order":"countdown","animate_on_scroll":false,"date_picker":"2025-09-25","time_picker":"00:00","countdown_block_font":"medium","completed_countdown":"hide_section","countdown_heading":"","headingtop":"FIRST DROP IN","descriptiontop":"","subheading":"","heading":"","heading_size":"h3","description":"","show_link":false,"button_label":"Shop now","button_style":"primary","button_link":"","button_arrow":false,"content_alignment":"center","enable_image":false,"overlay_opacity":0,"padding_top":"no-indent","padding_bottom":"no-indent","margin_top":"no-indent","margin_bottom":"no-indent"}},"custom_liquid_34QL3P":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div class=\"icon-txt-main\">\n<div class=\"icon-txt-content\">\n<div class=\"icon-txt\">\n    <div class=\"img-icn\">\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0279\/5133\/3450\/files\/streamline_flash-2.png?v=1757491162\">\n    <\/div>\n    <p>Loved by 100K+ Sneakerheads <\/p>\n<\/div>\n<div class=\"icon-txt\">\n    <div class=\"img-icn\">\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0279\/5133\/3450\/files\/Vector_1.png?v=1757488748\">\n    <\/div>\n    <p>Premium Design & Comfort<\/p>\n<\/div>\n<div class=\"icon-txt\">\n    <div class=\"img-icn\">    \n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0279\/5133\/3450\/files\/Group_1597881179.png?v=1757491162\">\n    <\/div>\n    <p>Engineered for all day comfort<\/p>\n<\/div>\n<\/div>\n<div class=\"border-line\"><\/div>\n<\/div>\n\n\n<style>\n    .icon-txt-main {\n  text-align: center;\n  padding: 20px 0;\n}\n\n.icon-txt-content {\n  display: flex;\n  justify-content: center;\n  gap: 60px; \/* space between each item *\/\n  margin-bottom: 15px;\n    padding: 0 10px;\n}\n\n.icon-txt {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 180px;\n}\n\n.icon-txt img {\n  width: 40px;  \/* adjust icon size *\/\n  height: auto;\n  margin-bottom: 10px;\n  \/* this makes icons gold-ish like screenshot *\/\n}\n\n.icon-txt p {\n  font-size: 14px;\n  font-weight: 500;\n  color: #000;\n  margin: 0;\n  line-height: 1.4;\n  font-family: 'Inter';\n}\n\n.border-line {\n  height: 4px;\n  width: 120px;\n  background: #000;\n  margin: 0 auto;\n  border-radius: 2px;\n}\n\n@media screen and (max-width: 767px) {\n    .icon-txt-content {\n    gap: 20px;\n}\n.icon-txt p {\n    font-size: 12px;\n}\n}\n<\/style>"}},"featured_product_prebook_3mnQ3E":{"type":"featured-product-prebook","blocks":{"title_9bF3kG":{"type":"title","settings":{"heading_size":"h2","heading_tag":"h2"}},"price_pXRLmT":{"type":"price","settings":{"show_tax_info":false}},"variant_picker_yRqJEY":{"type":"variant_picker","settings":{"picker_type":"button","swatch_type":"variant_image","variant_image_size":"portrait","unavailable_options_clickable":false}},"custom_liquid_PbB4Gk":{"type":"custom_liquid","settings":{"custom_liquid":"<p class=\"fewp\">ONLY FEW PIECES AVAILABLE! <\/p>\n\n<style>\np.fewp {\n    background: #14AE5C;\n    color: white;\n    font-family: 'Inter';\n    text-align: center;\n    padding: 5px;\n    font-weight: 500;\n    max-width: 480px;\n}\n<\/style>"}},"buy_buttons_fHLfe9":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"show_quantity":false}},"custom_liquid_F6QzLr":{"type":"custom_liquid","settings":{"custom_liquid":"<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const productButtons = document.querySelector('.product-form__buttons');\n  if (!productButtons) return;\n\n  \/\/ Clone sticky layout\n  const stickyClone = document.createElement('div');\n  stickyClone.classList.add('sticky-product-form-buttons');\n\n  \/\/ add wrapper for layout\n  const buttonWrapper = document.createElement('div');\n  buttonWrapper.classList.add('sticky-buttons-row');\n  buttonWrapper.appendChild(productButtons.cloneNode(true)); \/\/ only clone once\n  stickyClone.appendChild(buttonWrapper);\n\n  \/\/ ➕ Add static payment info below sticky buttons\n  const payInfo = document.createElement('div');\n  payInfo.className = 'pay-img stickyone';\n  payInfo.innerHTML = `\n    <p>SECURE PAYMENTS<\/p>\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0279\/5133\/3450\/files\/Frame_82_762039a6-bafc-4c49-aeee-d0cafde8d43f.png?v=1758952875\" width=\"100%\" height=\"auto\">\n  `;\n  stickyClone.appendChild(payInfo);\n\n  document.body.appendChild(stickyClone);\n\n  \/\/ Observe visibility\n  const observer = new IntersectionObserver(entries => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        stickyClone.classList.remove('visible');\n      } else {\n        stickyClone.classList.add('visible');\n      }\n    });\n  });\n  observer.observe(productButtons);\n\n  \/\/ Create popup element\n  const variantPopup = document.createElement('div');\n  variantPopup.className = 'variant-popup';\n  variantPopup.innerHTML = `\n    <div class=\"variant-popup__overlay\"><\/div>\n    <div class=\"variant-popup__content\">\n      <div class=\"variant-popup__header\">\n        <div class=\"variant-popup__title-row\">\n        <h3>Select Your Size<\/h3>\n        <div class=\"popup-size-chart\"><\/div>\n      <\/div>\n        <button class=\"variant-popup__close\">&times;<\/button>\n      <\/div>\n      <div class=\"variant-popup__variants\"><\/div>\n      <div class=\"size-txt\">Make sure you've got the right size!<\/div>\n      <div class=\"variant-popup__buttons\">\n        <button class=\"button button--primary variant-popup__add-to-cart\">Add to Cart<\/button>\n        <button class=\"button button--secondary variant-popup__buy-now\">Buy Now\n         <span class=\"popup-btn-price\">\n          {% if product.compare_at_price > product.price %}\n            <span class=\"popup-btn-compare\"><del>{{ product.compare_at_price | money_without_trailing_zeros | replace: 'Rs.', '₹' }}<\/del><\/span>\n          {% endif %}\n          <span class=\"popup-btn-current\">{{ product.price | money_without_trailing_zeros | replace: 'Rs.', '₹' }}<\/span>\n        <\/span>\n        <\/button>\n      <\/div>\n      <div class=\"pay-img stickyone\">\n          <p>SECURE PAYMENTS<\/p>\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0279\/5133\/3450\/files\/Frame_82_762039a6-bafc-4c49-aeee-d0cafde8d43f.png?v=1758952875\" width=\"100%\" height=\"auto\">\n        <\/div>\n    <\/div>\n  `;\n  document.body.appendChild(variantPopup);\n\n  \/\/ 🔥 BLOCK GOKWIK CHECKOUT IF VARIANTS NOT SELECTED (CAPTURE PHASE)\ndocument.addEventListener('click', function (e) {\n  const buyNowBtn = e.target.closest('#gokwik-buy-now');\n  if (!buyNowBtn) return;\n\n  \/\/ Only for sticky button\n  const isSticky = buyNowBtn.closest('.sticky-product-form-buttons');\n  if (!isSticky) return;\n\n  \/\/ If variants NOT selected → stop GoKwik immediately\n  if (!allVariantsSelected()) {\n    e.preventDefault();\n    e.stopImmediatePropagation(); \/\/ ⬅️ THIS IS THE KEY\n    openVariantPopup();\n  }\n}, true); \/\/ 👈 CAPTURE PHASE (IMPORTANT)\n\n\n  \/\/ Elements\n  const stickyAddToCart = stickyClone.querySelector('[name=\"add\"]');\n  const stickyBuyNow = stickyClone.querySelector('#gokwik-buy-now');\n  const originalAddToCart = productButtons.querySelector('[name=\"add\"]');\n  const originalBuyNow = productButtons.querySelector('#gokwik-buy-now');\n\n  \/\/ === Variant Availability Check ===\n  function checkVariantAvailability() {\n    \/\/ Check multiple indicators for out-of-stock status\n    const availabilitySelectors = [\n      '.product-form__inventory',\n      '[data-inventory-message]',\n      '.product__info-wrapper .inventory',\n      '.product-variant-availability',\n      '.variant-inventory'\n    ];\n    \n    let isOutOfStock = false;\n    \n    \/\/ Check text-based availability indicators\n    availabilitySelectors.forEach(selector => {\n      const element = document.querySelector(selector);\n      if (element) {\n        const text = element.textContent.toLowerCase();\n        if (text.includes('out of stock') || text.includes('sold out') || text.includes('unavailable') || text.includes('not available')) {\n          isOutOfStock = true;\n        }\n      }\n    });\n    \n    \/\/ Check if Add to Cart button is disabled\n    const addToCartBtn = document.querySelector('.product-form__submit[disabled]');\n    if (addToCartBtn && addToCartBtn.disabled) {\n      isOutOfStock = true;\n    }\n    \n    \/\/ Check for out-of-stock badges on variant inputs\n    const outOfStockInputs = document.querySelectorAll('.product-form__input input[disabled]');\n    if (outOfStockInputs.length > 0) {\n      const checkedInput = document.querySelector('.product-form__input input:checked');\n      if (checkedInput && checkedInput.disabled) {\n        isOutOfStock = true;\n      }\n    }\n    \n    return !isOutOfStock;\n  }\n\n  \/\/ === Update Sticky Button State ===\n  function updateStickyButtonState() {\n    const isInStock = checkVariantAvailability();\n    const stickyWrapper = document.querySelector('.sticky-buttons-row');\n    const stickyBuyNowBtn = document.querySelector('.sticky-product-form-buttons #gokwik-buy-now');\n    \n    if (!stickyBuyNowBtn || !stickyWrapper) return;\n    \n    \/\/ Remove any existing error message\n    const existingError = stickyWrapper.querySelector('.sticky-oos-error');\n    if (existingError) {\n      existingError.remove();\n    }\n    \n    if (!isInStock) {\n      \/\/ Variant is out of stock - disable button and show error\n      stickyBuyNowBtn.classList.add('sticky-buy-now-disabled');\n      stickyBuyNowBtn.setAttribute('disabled', 'disabled');\n      \n      \/\/ Add error message\n      const errorDiv = document.createElement('div');\n      errorDiv.className = 'sticky-oos-error visible';\n      errorDiv.textContent = 'Selected variant is currently out of stock';\n      stickyWrapper.appendChild(errorDiv);\n    } else {\n      \/\/ Variant is in stock - enable button\n      stickyBuyNowBtn.classList.remove('sticky-buy-now-disabled');\n      stickyBuyNowBtn.removeAttribute('disabled');\n    }\n  }\n\n  \/\/ === Update Popup Button State ===\n  function updatePopupButtonState() {\n    const isInStock = checkVariantAvailability();\n    const popupBuyNowBtn = variantPopup.querySelector('.variant-popup__buy-now');\n    const popupButtonsContainer = variantPopup.querySelector('.variant-popup__buttons');\n    \n    if (!popupBuyNowBtn || !popupButtonsContainer) return;\n    \n    \/\/ Remove any existing error message\n    const existingError = popupButtonsContainer.querySelector('.popup-oos-error');\n    if (existingError) {\n      existingError.remove();\n    }\n    \n    if (!isInStock) {\n      \/\/ Variant is out of stock - disable button and show error\n      popupBuyNowBtn.classList.add('popup-buy-now-disabled');\n      popupBuyNowBtn.setAttribute('disabled', 'disabled');\n      \n      \/\/ Add error message\n      const errorDiv = document.createElement('div');\n      errorDiv.className = 'popup-oos-error visible';\n      errorDiv.textContent = 'Selected variant is currently out of stock';\n      popupButtonsContainer.insertBefore(errorDiv, popupBuyNowBtn);\n    } else {\n      \/\/ Variant is in stock - enable button\n      popupBuyNowBtn.classList.remove('popup-buy-now-disabled');\n      popupBuyNowBtn.removeAttribute('disabled');\n    }\n  }\n\n  \/\/ === Observe Variant Changes ===\n  function observeVariantChanges() {\n    const variantContainer = document.querySelector('.product-form__controls');\n    if (variantContainer) {\n      const variantObserver = new MutationObserver(function(mutations) {\n        mutations.forEach(function(mutation) {\n          if (mutation.type === 'attributes' || mutation.type === 'childList') {\n            setTimeout(updateStickyButtonState, 100);\n            setTimeout(updatePopupButtonState, 100);\n          }\n        });\n      });\n      \n      variantObserver.observe(variantContainer, {\n        attributes: true,\n        childList: true,\n        subtree: true,\n        attributeFilter: ['class', 'data-inventory', 'disabled', 'data-available']\n      });\n    }\n    \n    \/\/ Also observe individual variant inputs\n    const variantInputs = document.querySelectorAll('.product-form__input input, .product-form__controls select');\n    variantInputs.forEach(input => {\n      input.addEventListener('change', function() {\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n        setTimeout(updateStickyButtonPrice, 100);\n      });\n    });\n  }\n\n  \/\/ === Sticky Price inside Buy Now Button ===\n  function updateStickyButtonPrice() {\n    \/\/ Get current price (sale price)\n    const currentPriceEl = document.querySelector('.price-item--sale');\n    \/\/ Get compare price from the strikethrough element\n    const comparePriceEl = document.querySelector('.price__sale s.price-item--regular');\n    \n    if (!currentPriceEl || !stickyBuyNow) return;\n\n    \/\/ Remove any old price spans first\n    const oldPrice = stickyBuyNow.querySelector('.sticky-btn-price');\n    if (oldPrice) oldPrice.remove();\n\n    \/\/ Get and clean price texts\n    const currentPriceText = currentPriceEl.textContent.trim().replace(\/Rs\\.?\\s*\/gi, '₹').replace(\/\\.00\\b\/g, '');\n    let comparePriceText = '';\n    \n    if (comparePriceEl) {\n      comparePriceText = comparePriceEl.textContent.trim().replace(\/Rs\\.?\\s*\/gi, '₹').replace(\/\\.00\\b\/g, '');\n    }\n\n    \/\/ Build new price markup\n    let html = `<span class=\"sticky-btn-price\">`;\n    \n    \/\/ Only show compare price if it exists and is different from current price\n    if (comparePriceText && comparePriceText !== currentPriceText) {\n      html += `<span class=\"sticky-btn-compare\">${comparePriceText}<\/span>`;\n    }\n    \n    html += `<span class=\"sticky-btn-current\">${currentPriceText}<\/span>`;\n    html += `<\/span>`;\n\n    \/\/ Append after Buy Now text\n    stickyBuyNow.insertAdjacentHTML('beforeend', html);\n  }\n\n  \/\/ Initial updates\n  updateStickyButtonPrice();\n  setTimeout(updateStickyButtonState, 500);\n  setTimeout(updatePopupButtonState, 500);\n\n  \/\/ Watch for price changes\n  const priceContainer = document.querySelector('.price');\n  if (priceContainer) {\n    const priceObserver = new MutationObserver(updateStickyButtonPrice);\n    priceObserver.observe(priceContainer, { \n      childList: true, \n      subtree: true, \n      characterData: true \n    });\n  }\n\n  \/\/ Start observing variant changes\n  observeVariantChanges();\n\n  \/\/ Popup elements\n  const popupOverlay = variantPopup.querySelector('.variant-popup__overlay');\n  const popupClose = variantPopup.querySelector('.variant-popup__close');\n  const popupVariants = variantPopup.querySelector('.variant-popup__variants');\n  const popupAddToCart = variantPopup.querySelector('.variant-popup__add-to-cart');\n  const popupBuyNow = variantPopup.querySelector('.variant-popup__buy-now');\n\n  \/\/ Helper: check if all variants selected (checks the real\/original form only)\n  function allVariantsSelected() {\n    \/\/ Check selects\n    const selects = document.querySelectorAll('.product-form__controls select');\n    for (const s of selects) {\n      if (!s.value) return false;\n    }\n\n    \/\/ Check radio groups by unique name\n    const radioInputs = document.querySelectorAll('.product-form__controls input[type=\"radio\"]');\n    const radioNames = [...new Set(Array.from(radioInputs).map(r => r.name).filter(Boolean))];\n    for (const name of radioNames) {\n      const checked = document.querySelector(`.product-form__controls input[type=\"radio\"][name=\"${name}\"]:checked`);\n      if (!checked) return false;\n    }\n\n    return true;\n  }\n\n  \/\/ Find size section\n  function findSizeVariantSection() {\n    const variantSections = document.querySelectorAll('.product-form__controls');\n    for (const section of variantSections) {\n      const legend = section.querySelector('legend');\n      if (legend) {\n        const legendText = legend.textContent.toLowerCase();\n        if (legendText.includes('size') || legendText.includes('sizes')) return section;\n      }\n      const groupName = section.querySelector('.product-form__group-name');\n      if (groupName) {\n        const groupText = groupName.textContent.toLowerCase();\n        if (groupText.includes('size') || groupText.includes('sizes')) return section;\n      }\n    }\n    return variantSections[0] || null;\n  }\n\n  \/\/ Clone & cleanup size options for popup\n  function extractSizeOptions() {\n    const sizeSection = findSizeVariantSection();\n    if (!sizeSection) {\n      console.log('No size section found');\n      return null;\n    }\n    const sizeClone = sizeSection.cloneNode(true);\n\n    \/\/ Keep only label part of legend\/groupname\n    const legend = sizeClone.querySelector('legend');\n    if (legend) {\n      const labelPart = legend.textContent.split(':')[0];\n      legend.textContent = labelPart + ':';\n    }\n    const groupName = sizeClone.querySelector('.product-form__group-name');\n    if (groupName) {\n      const labelPart = groupName.textContent.split(':')[0];\n      groupName.textContent = labelPart + ':';\n    }\n\n    return sizeClone;\n  };\n\n  \/\/ Clone Size Chart button from PDP into popup\n  const sizeChartSource = document.querySelector('.product-popup');\n  if (sizeChartSource) {\n    const sizeChartClone = sizeChartSource.cloneNode(true);\n    const popupChartTarget = variantPopup.querySelector('.popup-size-chart');\n    if (popupChartTarget) popupChartTarget.appendChild(sizeChartClone);\n  };\n\n  \/\/ Make popup inputs independent and wire sync listeners\n  function preparePopupInputsAndListeners() {\n    \/\/ Radios\n    const popupRadios = popupVariants.querySelectorAll('input[type=\"radio\"]');\n    popupRadios.forEach((radio, i) => {\n      const origName = radio.name || '';\n      const origValue = radio.value || '';\n      \/\/ ensure unique id and update label 'for' inside popup\n      const origId = radio.id || `popup-radio-${i}`;\n      const newId = origId + '-popup-' + Math.random().toString(36).slice(2,6);\n      radio.dataset.originalName = origName;\n      radio.dataset.originalValue = origValue;\n      radio.id = newId;\n\n      \/\/ update label inside popup that referenced the original id (if any)\n      const lbl = popupVariants.querySelector(`label[for=\"${origId}\"]`) || radio.nextElementSibling;\n      if (lbl && lbl.tagName === 'LABEL') lbl.setAttribute('for', newId);\n\n      \/\/ remove name to prevent browser grouping with page radios (this was the root cause)\n      radio.removeAttribute('name');\n\n      \/\/ add change listener to sync popup -> original\n      radio.addEventListener('change', function() {\n        const oName = this.dataset.originalName;\n        const oValue = this.dataset.originalValue;\n\n        \/\/ 🔹 Uncheck other popup radios from the same option group\n        const groupRadios = popupVariants.querySelectorAll(`input[data-original-name=\"${oName}\"]`);\n        groupRadios.forEach(r => {\n          if (r !== this) {\n            r.checked = false;\n          }\n        });\n\n        \/\/ 🔹 Sync selection with the original variant input\n        if (oName) {\n          const originalRadio = document.querySelector(`input[type=\"radio\"][name=\"${oName}\"][value=\"${oValue}\"]`);\n          if (originalRadio) {\n            originalRadio.checked = true;\n            originalRadio.dispatchEvent(new Event('change', { bubbles: true }));\n          }\n        }\n\n        \/\/ Update sticky button state after variant change\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n      });\n    });\n\n    \/\/ Selects (if your variant uses select dropdown)\n    const popupSelects = popupVariants.querySelectorAll('select');\n    popupSelects.forEach((sel, i) => {\n      const origName = sel.name || '';\n      sel.dataset.originalName = origName;\n      const newId = (sel.id || `popup-select-${i}`) + '-popup-' + Math.random().toString(36).slice(2,6);\n      sel.id = newId;\n      sel.removeAttribute('name');\n      sel.addEventListener('change', function() {\n        const oName = this.dataset.originalName;\n        if (oName) {\n          const originalSelect = document.querySelector(`select[name=\"${oName}\"]`);\n          if (originalSelect) {\n            originalSelect.value = this.value;\n            originalSelect.dispatchEvent(new Event('change', { bubbles: true }));\n          }\n        }\n        \/\/ Update sticky button state after variant change\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n      });\n    });\n\n    \/\/ Sync initial selection from original form -> popup UI\n    const originalChecked = document.querySelectorAll('.product-form__controls input[type=\"radio\"]:checked');\n    originalChecked.forEach(orig => {\n      const popupMatch = popupVariants.querySelector(`input[data-original-name=\"${orig.name}\"][data-original-value=\"${orig.value}\"]`);\n      if (popupMatch) popupMatch.checked = true;\n    });\n    \/\/ selects\n    const originalSelects = document.querySelectorAll('.product-form__controls select');\n    originalSelects.forEach(os => {\n      const popupSel = popupVariants.querySelector(`select[data-original-name=\"${os.name}\"]`);\n      if (popupSel) popupSel.value = os.value;\n    });\n  }\n\n  \/\/ Opens popup\n  function openVariantPopup() {\n    const sizeOptions = extractSizeOptions();\n    if (sizeOptions) {\n      popupVariants.innerHTML = '';\n      popupVariants.appendChild(sizeOptions);\n\n      \/\/ IMPORTANT: make popup radios\/selects independent and add listeners\n      preparePopupInputsAndListeners();\n\n    } else {\n      popupVariants.innerHTML = '<p style=\"text-align: center; padding: 20px; color: #666;\">Size options not available<\/p>';\n    }\n\n    variantPopup.classList.add('active');\n    document.body.style.overflow = 'hidden';\n    \n    \/\/ Update popup button state when opening\n    setTimeout(updatePopupButtonState, 100);\n  }\n\n  function closeVariantPopup() {\n    variantPopup.classList.remove('active');\n    document.body.style.overflow = '';\n    \/\/ Update sticky button state when popup closes\n    setTimeout(updateStickyButtonState, 100);\n  }\n\n  \/\/ Popup button handlers\n  popupOverlay.addEventListener('click', closeVariantPopup);\n  popupClose.addEventListener('click', closeVariantPopup);\n\n  popupAddToCart.addEventListener('click', function() {\n    if (allVariantsSelected()) {\n      originalAddToCart.click();\n      closeVariantPopup();\n    } else {\n      popupVariants.classList.add('highlight-missing');\n      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);\n    }\n  });\n\n  popupBuyNow.addEventListener('click', function() {\n    \/\/ Check if variant is out of stock\n    if (!checkVariantAvailability()) {\n      \/\/ Don't proceed if OOS\n      return;\n    }\n\n    if (allVariantsSelected()) {\n      originalBuyNow.click();\n      closeVariantPopup();\n    } else {\n      popupVariants.classList.add('highlight-missing');\n      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);\n    }\n  });\n\n  \/\/ Sticky handlers\n  if (stickyAddToCart && originalAddToCart) {\n    stickyAddToCart.addEventListener('click', function(e) {\n      e.preventDefault();\n      if (!allVariantsSelected()) openVariantPopup();\n      else originalAddToCart.click();\n    });\n  }\n\n  if (stickyBuyNow && originalBuyNow) {\n    stickyBuyNow.addEventListener('click', function(e) {\n      e.preventDefault();\n\n      \/\/ Check if variant is out of stock\n      if (!checkVariantAvailability()) {\n        \/\/ Show popup instead of proceeding when OOS\n        openVariantPopup();\n        return;\n      }\n\n      if (!allVariantsSelected()) {\n        openVariantPopup();\n        return;\n      }\n\n      \/\/ Reset quantity to 1 to avoid carryover\n      const qtyInput = document.querySelector('form.product-form input[name=\"quantity\"]');\n      if (qtyInput) qtyInput.value = 1;\n\n      \/\/ Clone Buy Now to clear duplicate event handlers\n      const safeBuyNow = originalBuyNow.cloneNode(true);\n      originalBuyNow.parentNode.replaceChild(safeBuyNow, originalBuyNow);\n\n      \/\/ Trigger the clean Buy Now click\n      safeBuyNow.click();\n    });\n  }\n\n  \/\/ Keep popup UI updated if original form changes while popup is open\n  function wireOriginalToPopupSync() {\n    \/\/ radios\n    const originalRadios = document.querySelectorAll('.product-form__controls input[type=\"radio\"]');\n    originalRadios.forEach(r => {\n      r.addEventListener('change', function() {\n        if (!variantPopup.classList.contains('active')) return;\n        const p = popupVariants.querySelector(`input[data-original-name=\"${this.name}\"][data-original-value=\"${this.value}\"]`);\n        if (p) p.checked = true;\n      });\n    });\n    \/\/ selects\n    const originalSelects = document.querySelectorAll('.product-form__controls select');\n    originalSelects.forEach(s => {\n      s.addEventListener('change', function() {\n        if (!variantPopup.classList.contains('active')) return;\n        const p = popupVariants.querySelector(`select[data-original-name=\"${this.name}\"]`);\n        if (p) p.value = this.value;\n      });\n    });\n  }\n  wireOriginalToPopupSync();\n\n  \/\/ Close popup with Escape\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape' && variantPopup.classList.contains('active')) {\n      closeVariantPopup();\n    }\n  });\n});\n<\/script>\n\n<style>\n\/* Sticky buttons *\/\n.sticky-product-form-buttons {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: #fff;\n  z-index: 99;\n  padding: 0;\n  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);\n  display: none;\n  transition: transform 0.3s ease, opacity 0.3s ease;\n}\n.sticky-buttons-row {\n    padding: 0px 15px;\n}\n\n.sticky-product-form-buttons.visible {\n  display: block;\n  opacity: 1;\n  transform: translateY(0);\n  padding-bottom: 15px;\n  padding-top: 15px;\n}\n.pay-img.stickyone {\n    background: transparent;\n    justify-content: center;\n    gap: 10px;\n    padding: 0;\n    margin-top: -5px;\n    align-items: center;\n    max-width: 100%;\ndisplay: flex;\n}\n.pay-img.stickyone p {\n    font-size: 9px;\n}\n.pay-img.stickyone img {\n    width: 40px;\n}\n.sticky-product-form-buttons:not(.visible) {\n  opacity: 0;\n  transform: translateY(100%);\n}\n\n\/* Out of Stock Styles *\/\n.sticky-buy-now-disabled,\n.popup-buy-now-disabled {\n  position: relative;\n  opacity: 0.6;\n  cursor: not-allowed !important;\n  pointer-events: none !important;\n}\n\n.sticky-buy-now-disabled::after,\n.popup-buy-now-disabled::after {\n  content: \"Out of Stock\";\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: rgba(0, 0, 0, 0.8);\n  color: white;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n.sticky-oos-error,\n.popup-oos-error {\n  background: #fff3f3;\n  border: 1px solid #ff4444;\n  color: #d00;\n  margin-bottom:10px;\n  border-radius: 5px;\n  font-size: 14px;\n  text-align: center;\n  display: none;\n  padding: 2px;\n}\n.popup-oos-error {\n    margin-bottom: 0px;\n    padding:2px 10px;\n}\n\n.sticky-oos-error.visible,\n.popup-oos-error.visible {\n  display: block;\n}\n\n\/* Variant Popup *\/\n.variant-popup {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 10000;\n  display: none;\n}\n\n.variant-popup.active {\n  display: block;\n}\nspan.popup-btn-price {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n}\nspan.popup-btn-compare {\n    font-size: 13px;\n    font-weight: 100;\n    font-family: 'Inter';\ncolor: rgba(255, 255, 255, 0.7);\n}\nspan.pop