<h1 style="text-align:center;">Your Wishlist</h1>
<div class="wishlist-wrapper">
  <div class="product-list__inner col-3 col-4 col-2 col-1" id="inner-list">
  <!-- Wishlist items will be dynamically loaded -->
  </div>
</div>

<script>
  function formatMoney(amount) {
    const formatter = new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "INR",
    });
    return formatter.format(amount / 100);
  }

  document.addEventListener("DOMContentLoaded", async () => {
    const wishlistContainer = document.getElementById("inner-list");
    const wishlistKey = "shopify_wishlist";
    const wishlist = JSON.parse(localStorage.getItem(wishlistKey)) || [];

    if (wishlist.length > 0) {
      const reversedWishlist = wishlist.reverse();

      const productPromises = reversedWishlist.map(async (productHandle) => {
        try {
          const response = await fetch(`/products/${productHandle}.js`);
          if (response.ok) {
            const product = await response.json();
            const hasDiscount = product.compare_at_price && product.compare_at_price > product.price;
            const comparePriceHtml = hasDiscount
              ? `<p class="compare-price" style="text-decoration: line-through; color: #999;">${formatMoney(product.compare_at_price)}</p>`
              : "";

            return `
              <div class="wishlist-item">
                <div class="wishlist-product">
                  <a class="item-link" href="/products/${product.handle}">
                    <img src="${product.featured_image}" alt="${product.title}" width="250">
                  </a>
                  <div class="product-item-details">
                    <div class="wishlist-details">
                      <a href="/products/${product.handle}"><h3>${product.title}</h3></a>
                      <div class="prices">
                        <p class="mrpprice">${formatMoney(product.price)}</p>
                        ${comparePriceHtml}
                      </div>
                    </div>
                    <div class="buttons-new">
                      <button class="quick-view" data-product-handle="${product.handle}">Add to Cart</button>
                      <button class="remove-wishlist-item" data-product-handle="${product.handle}">Remove</button>
                    </div>
                  </div>
                </div>
              </div>
            `;
          } else {
            return `<p>Product "${productHandle}" could not be loaded.</p>`;
          }
        } catch (error) {
          return `<p>Error loading product "${productHandle}".</p>`;
        }
      });

      const productsHtml = await Promise.all(productPromises);
      wishlistContainer.innerHTML = productsHtml.join("");

      document.querySelectorAll(".quick-view").forEach((button) => {
        button.addEventListener("click", async (event) => {
          const productHandle = event.target.dataset.productHandle;
          const response = await fetch(`/products/${productHandle}.js`);
          if (response.ok) {
            const product = await response.json();

            const quickViewHtml = `
              <div class="quick-view-popup">
                <button class="close-quick-view">X</button>
                <div class="header-close"></div>
                <div class="main-sec">
                  <div class="main-img">
                    <img id="quick-view-image" src="${product.featured_image}" alt="${product.title}" width="350">
                  </div>
                  <div class="product-options">
                    <h2>${product.title}</h2>
                    <div class="variant-options">
                      <h3 style="margin-bottom: 0;">Color</h3>
                      <div class="selected-details">
                        <p class="selected-color" style="display: none; margin-bottom: 0;">Selected Color: None</p>
                      </div>
                      <div class="color-options">
                        ${getUniqueColors(product.variants).map(variant => `
                          <button 
                            type="button" 
                            class="variant-option color-option" 
                            data-variant-id="${variant.id}" 
                            data-color="${variant.option1}" 
                            data-image="${variant.featured_image?.src || product.featured_image}">
                            <img src="${variant.featured_image?.src || product.featured_image}" alt="${variant.option1}" width="70" />
                          </button>
                        `).join('')}
                      </div>
                    </div>

                    <div class="size-options" style="display: none;">
                      <h3 style="margin-bottom: 0;">Size</h3>
                      <div class="selected-details">
                        <p class="selected-size" style="display: none; margin-bottom: 0;">Selected Size: None</p>
                      </div>
                      <div class="sizes"></div>
                    </div>

                    <button type="button" class="add-to-cart" style="display: none;">Add to Cart</button>
                  </div>
                </div>
              </div>
            `;

            const quickViewContainer = document.createElement("div");
            quickViewContainer.classList.add("quick-view-overlay");
            quickViewContainer.innerHTML = quickViewHtml;
            document.body.appendChild(quickViewContainer);

            document.querySelectorAll(".color-option").forEach(button => {
              button.addEventListener("click", (event) => {
                document.querySelectorAll(".color-option").forEach((btn) => btn.style.border = "none");
                event.currentTarget.style.border = "2px solid black";

                const selectedColor = event.currentTarget.dataset.color;
                const selectedImage = event.currentTarget.dataset.image;
                const sizeOptionsContainer = document.querySelector(".size-options .sizes");
                const addToCartButton = document.querySelector(".add-to-cart");
                const selectedVariants = product.variants.filter(variant => variant.option1 === selectedColor);

                document.getElementById("quick-view-image").src = selectedImage;
                const colorDisplay = document.querySelector(".selected-color");
                colorDisplay.textContent = `Selected Color: ${selectedColor}`;
                colorDisplay.style.display = "block";

                sizeOptionsContainer.innerHTML = selectedVariants.map(variant => `
                  <button 
                    type="button" 
                    class="variant-option size-option" 
                    data-variant-id="${variant.id}">
                    ${variant.option2}
                  </button>
                `).join('');

                document.querySelector(".size-options").style.display = "block";
                addToCartButton.style.display = "block";

                document.querySelectorAll(".size-option").forEach(sizeButton => {
                  sizeButton.addEventListener("click", () => {
                    document.querySelectorAll(".size-option").forEach((btn) => btn.style.border = "none");
                    sizeButton.style.border = "2px solid black";

                    addToCartButton.setAttribute("data-variant-id", sizeButton.dataset.variantId);

                    const sizeDisplay = document.querySelector(".selected-size");
                    sizeDisplay.textContent = `Selected Size: ${sizeButton.textContent}`;
                    sizeDisplay.style.display = "block";
                  });
                });
              });
            });

            quickViewContainer.querySelector(".add-to-cart").addEventListener("click", async (event) => {
              const variantId = event.target.getAttribute("data-variant-id");
              const productName = document.querySelector(".product-options h2").textContent;
              const selectedColor = document.querySelector(".selected-color").textContent.replace("Selected Color: ", "");
              const selectedSize = document.querySelector(".selected-size").textContent.replace("Selected Size: ", "");
              const selectedVariantImage = document.getElementById("quick-view-image").src;

              if (!variantId) {
                alert("Please select a variant.");
                return;
              }

              if (window.clevertap) {
                window.clevertap.event.push("Wishlist Add to Cart", {
                  "Product Name": productName,
                  "Selected Color": selectedColor || "None",
                  "Selected Size": selectedSize || "None",
                  "Selected Variant Image": selectedVariantImage,
                });
              } else {
                console.warn("CleverTap is not available.");
              }

              // Add product to cart using Shopify's cart API
              try {
                const response = await fetch("/cart/add.js", {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({ id: variantId, quantity: 1 }),
                });

                if (response.ok) {
                  alert("Product added to cart!");
                  window.location.href = "/cart"; // Redirect to cart page
                } else {
                  const error = await response.json();
                  alert(`Error: ${error.message}`);
                }
              } catch (error) {
                console.error("Error adding to cart:", error);
              }
            });

            quickViewContainer.querySelector(".close-quick-view").addEventListener("click", () => {
              document.body.removeChild(quickViewContainer);
            });
          }
        });
      });

      document.querySelectorAll(".remove-wishlist-item").forEach((button) => {
        button.addEventListener("click", (event) => {
          const productHandle = event.target.dataset.productHandle;
          const updatedWishlist = wishlist.filter((handle) => handle !== productHandle);
          localStorage.setItem(wishlistKey, JSON.stringify(updatedWishlist));
          location.reload();
        });
      });
    } else {
      wishlistContainer.innerHTML = '<p style="text-align: center;width: 100%;position: absolute;right: 0;">Wishlist is empty.</p>';
    }
  });

  function getUniqueColors(variants) {
    const colorMap = {};
    variants.forEach(variant => {
      colorMap[variant.option1] = variant;
    });
    return Object.values(colorMap);
  }
</script>





