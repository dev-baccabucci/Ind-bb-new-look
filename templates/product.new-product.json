            "custom_liquid": "<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  // Create the Rare Find banner\n  const rareFindBanner = document.createElement('div');\n  rareFindBanner.className = 'rare-find-banner';\n  rareFindBanner.innerHTML = `\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/SketchLogo.png?v=1760341828\" width=\"20px\">\n    <span><strong>RARE FIND</strong> <em>This product is usually sold out</em></span>\n  `;\n  rareFindBanner.style.display = 'none';\n\n  // Append it inside sticky button area\n  const stickyContainer = document.querySelector('.sticky-product-form-buttons');\n  if (stickyContainer) stickyContainer.insertBefore(rareFindBanner, stickyContainer.firstChild);\n\nwindow.addEventListener('scroll', function() {\n    const scrollPosition = window.scrollY;\n    const documentHeight = document.documentElement.scrollHeight - window.innerHeight;\n    const scrollPercent = (scrollPosition / documentHeight) * 100;\n\n    if (scrollPercent >= 20) {\n      rareFindBanner.style.display = 'flex';\n    } else {\n      rareFindBanner.style.display = 'none';\n    }\n  });\n});\n</script>\n\n<style>\n.rare-find-banner {\n display: flex;\n    align-items: center;\n    gap: 8px;\n    background: linear-gradient(rgba(255, 255, 255, 1) 0%, rgba(253, 250, 255, 1) 7%, rgba(251, 245, 255, 1) 22%, rgb(233 207 255 / 66%) 84%, rgb(233 207 255 / 38%) 100%);\n    padding: 0px 12px;\n    margin-bottom: 10px;\n    font-family: 'Inter', sans-serif;\n    font-size: 13px;\n    color: #555;\n    transition: opacity 0.3s \nease, transform 0.3s \nease;\n    justify-content: center;\n    padding-bottom: 4px;\n}\n.rare-find-banner svg {\n  flex-shrink: 0;\n}\n.rare-find-banner strong {\n  color: #7b3ef3;\n  margin-right: 4px;\n}\n.rare-find-banner em {\n   font-style: italic;\n    color: #3f3e3e;\n    font-size: 13px;\n    font-family: 'Inter';\n    font-weight: 500;\n}\n</style>"
          }
        }
