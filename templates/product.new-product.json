n    const sub = document.querySelector('.cstm-sub');\n    const btn = document.querySelector('.cstm-readmore-btn');\n\n    if (!sub || !btn) return;\n\n    // Check if text is overflowing (more than 1 line)\n    if (sub.scrollWidth > sub.clientWidth || sub.scrollHeight > sub.clientHeight) {\n      btn.style.display = 'inline-block';\n    } else {\n      btn.style.display = 'none';\n    }\n  }\n\n  function openSubPopup() {\n    document.getElementById('subPopup').style.display = 'flex';\n    document.body.style.overflow = 'hidden';\n  }\n\n  function closeSubPopup() {\n    document.getElementById('subPopup').style.display = 'none';\n    document.body.style.overflow = 'auto';\n  }\n\n  document.addEventListener('DOMContentLoaded', function () {\n    checkSubheadingOverflow();\n  });\n\n  window.addEventListener('resize', function () {\n    checkSubheadingOverflow();\n  });\n\n  document.addEventListener('click', function (e) {\n    const popup = document.getElementById('subPopup');\n    if (e.target === popup) {\n      closeSubPopup();\n    }\n  });\n</script>\n\n{% endif %}"
