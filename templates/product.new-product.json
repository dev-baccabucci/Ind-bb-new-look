        "custom_liquid_6fGrzE": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const productButtons = document.querySelector('.product-form__buttons');\n  if (!productButtons) return;\n\n  // Clone sticky layout\n  const stickyClone = document.createElement('div');\n  stickyClone.classList.add('sticky-product-form-buttons');\n\n  // add wrapper for layout\n  const buttonWrapper = document.createElement('div');\n  buttonWrapper.classList.add('sticky-buttons-row');\n  buttonWrapper.appendChild(productButtons.cloneNode(true));\n  stickyClone.appendChild(buttonWrapper);\n\n  // Add static payment info below sticky buttons\n  {% comment %} const payInfo = document.createElement('div');\n  payInfo.className = 'pay-img stickyone';\n  payInfo.innerHTML = `\n    <p>SECURE PAYMENTS</p>\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Frame_82_762039a6-bafc-4c49-aeee-d0cafde8d43f.png?v=1758952875\" width=\"100%\" height=\"auto\">\n  `;\n  stickyClone.appendChild(payInfo); {% endcomment %}\n\n  document.body.appendChild(stickyClone);\n\n  // Observe visibility\n  const observer = new IntersectionObserver(entries => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        stickyClone.classList.remove('visible');\n      } else {\n        stickyClone.classList.add('visible');\n      }\n    });\n  });\n  observer.observe(productButtons);\n\n  // Create popup element\n  const variantPopup = document.createElement('div');\n  variantPopup.className = 'variant-popup';\n  variantPopup.innerHTML = `\n    <div class=\"variant-popup__overlay\"></div>\n    <div class=\"variant-popup__content\">\n      <div class=\"variant-popup__header\">\n        <div class=\"variant-popup__title-row\">\n        <h3>Select Your Size</h3>\n        <div class=\"popup-size-chart\"></div>\n      </div>\n        <button class=\"variant-popup__close\">&times;</button>\n      </div>\n      <div class=\"variant-popup__variants\"></div>\n      <div class=\"size-txt\">Make sure you've got the right size!</div>\n      <div class=\"variant-popup__buttons\">\n        <button class=\"button button--primary variant-popup__add-to-cart\">Add to Cart</button>\n        <button class=\"button button--secondary variant-popup__buy-now\">Buy Now</button>\n      </div>\n    </div>\n  `;\n  document.body.appendChild(variantPopup);\n\n  // Elements\n  const stickyAddToCart = stickyClone.querySelector('[name=\"add\"]');\n  const stickyBuyNow = stickyClone.querySelector('#gokwik-buy-now');\n  const originalAddToCart = productButtons.querySelector('[name=\"add\"]');\n  const originalBuyNow = productButtons.querySelector('#gokwik-buy-now');\n\n  // === ✅ FIXED: Variant Availability Check (based on current selection) ===\n  function checkVariantAvailability() {\n    // 1. Check if main Add to Cart button is disabled\n    const addToCartBtn = document.querySelector('.product-form__submit');\n    if (addToCartBtn && addToCartBtn.disabled) {\n      return false;\n    }\n\n    // 2. For radio inputs: if the checked radio is disabled -> OOS\n    const checkedRadio = document.querySelector('.product-form__input input[type=\"radio\"]:checked');\n    if (checkedRadio && checkedRadio.disabled) {\n      return false;\n    }\n\n    // 3. For select dropdowns: if the selected option is disabled -> OOS\n    const selects = document.querySelectorAll('.product-form__controls select');\n    for (const select of selects) {\n      if (select.value) {\n        const selectedOption = select.options[select.selectedIndex];\n        if (selectedOption && selectedOption.disabled) {\n          return false;\n        }\n      }\n    }\n\n    return true;\n  }\n\n  // === Update Sticky Button States (Add to Cart + Buy Now) ===\n  function updateStickyButtonState() {\n    const isInStock = checkVariantAvailability();\n    const stickyWrapper = document.querySelector('.sticky-buttons-row');\n    const stickyBuyNowBtn = document.querySelector('.sticky-product-form-buttons #gokwik-buy-now');\n    const stickyAddToCartBtn = document.querySelector('.sticky-product-form-buttons [name=\"add\"]');\n    \n    if (!stickyWrapper) return;\n    \n    // Remove any existing error message\n    const existingError = stickyWrapper.querySelector('.sticky-oos-error');\n    if (existingError) existingError.remove();\n    \n    if (!isInStock) {\n      // Disable both buttons and show error\n      if (stickyBuyNowBtn) {\n        stickyBuyNowBtn.classList.add('sticky-buy-now-disabled');\n        stickyBuyNowBtn.setAttribute('disabled', 'disabled');\n      }\n      if (stickyAddToCartBtn) {\n        stickyAddToCartBtn.classList.add('sticky-add-to-cart-disabled');\n        stickyAddToCartBtn.setAttribute('disabled', 'disabled');\n      }\n      const errorDiv = document.createElement('div');\n      errorDiv.className = 'sticky-oos-error visible';\n      errorDiv.textContent = 'Selected variant is currently out of stock';\n      stickyWrapper.appendChild(errorDiv);\n    } else {\n      // Enable both buttons\n      if (stickyBuyNowBtn) {\n        stickyBuyNowBtn.classList.remove('sticky-buy-now-disabled');\n        stickyBuyNowBtn.removeAttribute('disabled');\n      }\n      if (stickyAddToCartBtn) {\n        stickyAddToCartBtn.classList.remove('sticky-add-to-cart-disabled');\n        stickyAddToCartBtn.removeAttribute('disabled');\n      }\n    }\n  }\n\n  // === Update Popup Button States (Add to Cart + Buy Now) ===\n  function updatePopupButtonState() {\n    const isInStock = checkVariantAvailability();\n    const popupButtonsContainer = variantPopup.querySelector('.variant-popup__buttons');\n    const popupBuyNowBtn = variantPopup.querySelector('.variant-popup__buy-now');\n    const popupAddToCartBtn = variantPopup.querySelector('.variant-popup__add-to-cart');\n    \n    if (!popupButtonsContainer) return;\n    \n    const existingError = popupButtonsContainer.querySelector('.popup-oos-error');\n    if (existingError) existingError.remove();\n    \n    if (!isInStock) {\n      if (popupBuyNowBtn) {\n        popupBuyNowBtn.classList.add('popup-buy-now-disabled');\n        popupBuyNowBtn.setAttribute('disabled', 'disabled');\n      }\n      if (popupAddToCartBtn) {\n        popupAddToCartBtn.classList.add('popup-add-to-cart-disabled');\n        popupAddToCartBtn.setAttribute('disabled', 'disabled');\n      }\n      const errorDiv = document.createElement('div');\n      errorDiv.className = 'popup-oos-error visible';\n      errorDiv.textContent = 'Selected variant is currently out of stock';\n      popupButtonsContainer.insertBefore(errorDiv, popupButtonsContainer.firstChild);\n    } else {\n      if (popupBuyNowBtn) {\n        popupBuyNowBtn.classList.remove('popup-buy-now-disabled');\n        popupBuyNowBtn.removeAttribute('disabled');\n      }\n      if (popupAddToCartBtn) {\n        popupAddToCartBtn.classList.remove('popup-add-to-cart-disabled');\n        popupAddToCartBtn.removeAttribute('disabled');\n      }\n    }\n  }\n\n  // === Observe Variant Changes ===\n  function observeVariantChanges() {\n    const variantContainer = document.querySelector('.product-form__controls');\n    if (variantContainer) {\n      const variantObserver = new MutationObserver(function() {\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n        setTimeout(updatePopupButtonPrices, 100);\n      });\n      variantObserver.observe(variantContainer, {\n        attributes: true,\n        childList: true,\n        subtree: true,\n        attributeFilter: ['class', 'disabled', 'data-available']\n      });\n    }\n    \n    const variantInputs = document.querySelectorAll('.product-form__input input, .product-form__controls select');\n    variantInputs.forEach(input => {\n      input.addEventListener('change', function() {\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n        setTimeout(updateStickyButtonPrice, 100);\n        setTimeout(updatePopupButtonPrices, 100);\n      });\n    });\n  }\n\n  // === Sticky Price inside Buy Now & Add to Cart Buttons ===\n  function updateStickyButtonPrice() {\n    const currentPriceEl = document.querySelector('.price-item--sale');\n    const comparePriceEl = document.querySelector('.price__sale s.price-item--regular');\n    if (!currentPriceEl) return;\n\n    const currentPriceText = currentPriceEl.textContent.trim().replace(/Rs\\.?\\s*/gi, '₹').replace(/\\.00\\b/g, '');\n    let comparePriceText = '';\n    if (comparePriceEl) {\n      comparePriceText = comparePriceEl.textContent.trim().replace(/Rs\\.?\\s*/gi, '₹').replace(/\\.00\\b/g, '');\n    }\n\n    if (stickyAddToCart) {\n      const oldPrice = stickyAddToCart.querySelector('.sticky-add-to-cart-price');\n      if (oldPrice) oldPrice.remove();\n      const priceSpan = document.createElement('span');\n      priceSpan.className = 'sticky-add-to-cart-price';\n      let html = '';\n      if (comparePriceText && comparePriceText !== currentPriceText) {\n        html += `<span class=\"compare\">${comparePriceText}</span>`;\n      }\n      html += `<span class=\"current\">${currentPriceText}</span>`;\n      priceSpan.innerHTML = html;\n      stickyAddToCart.appendChild(priceSpan);\n    }\n\n    if (stickyBuyNow) {\n      const oldPrice = stickyBuyNow.querySelector('.sticky-btn-price');\n      if (oldPrice) oldPrice.remove();\n      const priceSpan = document.createElement('span');\n      priceSpan.className = 'sticky-btn-price';\n      let html = '';\n      if (comparePriceText && comparePriceText !== currentPriceText) {\n        html += `<span class=\"sticky-btn-compare\">${comparePriceText}</span>`;\n      }\n      html += `<span class=\"sticky-btn-current\">${currentPriceText}</span>`;\n      priceSpan.innerHTML = html;\n      stickyBuyNow.appendChild(priceSpan);\n    }\n  }\n\n  // === Popup Price inside Buy Now & Add to Cart Buttons ===\n  function updatePopupButtonPrices() {\n    const currentPriceEl = document.querySelector('.price-item--sale');\n    const comparePriceEl = document.querySelector('.price__sale s.price-item--regular');\n    if (!currentPriceEl) return;\n\n    const currentPriceText = currentPriceEl.textContent.trim().replace(/Rs\\.?\\s*/gi, '₹').replace(/\\.00\\b/g, '');\n    let comparePriceText = '';\n    if (comparePriceEl) {\n      comparePriceText = comparePriceEl.textContent.trim().replace(/Rs\\.?\\s*/gi, '₹').replace(/\\.00\\b/g, '');\n    }\n\n    const popupAddToCart = variantPopup.querySelector('.variant-popup__add-to-cart');\n    if (popupAddToCart) {\n      const oldPrice = popupAddToCart.querySelector('.popup-add-to-cart-price');\n      if (oldPrice) oldPrice.remove();\n      const priceSpan = document.createElement('span');\n      priceSpan.className = 'popup-add-to-cart-price';\n      let html = '';\n      if (comparePriceText && comparePriceText !== currentPriceText) {\n        html += `<span class=\"compare\">${comparePriceText}</span>`;\n      }\n      html += `<span class=\"current\">${currentPriceText}</span>`;\n      priceSpan.innerHTML = html;\n      popupAddToCart.appendChild(priceSpan);\n    }\n\n    const popupBuyNow = variantPopup.querySelector('.variant-popup__buy-now');\n    if (popupBuyNow) {\n      const oldPrice = popupBuyNow.querySelector('.popup-buy-now-price');\n      if (oldPrice) oldPrice.remove();\n      const priceSpan = document.createElement('span');\n      priceSpan.className = 'popup-buy-now-price';\n      let html = '';\n      if (comparePriceText && comparePriceText !== currentPriceText) {\n        html += `<span class=\"compare\">${comparePriceText}</span>`;\n      }\n      html += `<span class=\"current\">${currentPriceText}</span>`;\n      priceSpan.innerHTML = html;\n      popupBuyNow.appendChild(priceSpan);\n    }\n  }\n\n  // Initial updates\n  updateStickyButtonPrice();\n  updatePopupButtonPrices();\n  setTimeout(updateStickyButtonState, 500);\n  setTimeout(updatePopupButtonState, 500);\n  setTimeout(updatePopupButtonPrices, 500);\n\n  // Watch for price changes\n  const priceContainer = document.querySelector('.price');\n  if (priceContainer) {\n    const priceObserver = new MutationObserver(() => {\n      updateStickyButtonPrice();\n      updatePopupButtonPrices();\n    });\n    priceObserver.observe(priceContainer, { \n      childList: true, \n      subtree: true, \n      characterData: true \n    });\n  }\n\n  observeVariantChanges();\n\n  // Popup elements\n  const popupOverlay = variantPopup.querySelector('.variant-popup__overlay');\n  const popupClose = variantPopup.querySelector('.variant-popup__close');\n  const popupVariants = variantPopup.querySelector('.variant-popup__variants');\n  const popupAddToCart = variantPopup.querySelector('.variant-popup__add-to-cart');\n  const popupBuyNow = variantPopup.querySelector('.variant-popup__buy-now');\n\n  function allVariantsSelected() {\n    const selects = document.querySelectorAll('.product-form__controls select');\n    for (const s of selects) {\n      if (!s.value) return false;\n    }\n    const radioInputs = document.querySelectorAll('.product-form__controls input[type=\"radio\"]');\n    const radioNames = [...new Set(Array.from(radioInputs).map(r => r.name).filter(Boolean))];\n    for (const name of radioNames) {\n      const checked = document.querySelector(`.product-form__controls input[type=\"radio\"][name=\"${name}\"]:checked`);\n      if (!checked) return false;\n    }\n    return true;\n  }\n\n  function findSizeVariantSection() {\n    const variantSections = document.querySelectorAll('.product-form__controls');\n    for (const section of variantSections) {\n      const legend = section.querySelector('legend');\n      if (legend) {\n        const legendText = legend.textContent.toLowerCase();\n        if (legendText.includes('size') || legendText.includes('sizes')) return section;\n      }\n      const groupName = section.querySelector('.product-form__group-name');\n      if (groupName) {\n        const groupText = groupName.textContent.toLowerCase();\n        if (groupText.includes('size') || groupText.includes('sizes')) return section;\n      }\n    }\n    return variantSections[0] || null;\n  }\n\n  function extractSizeOptions() {\n    const sizeSection = findSizeVariantSection();\n    if (!sizeSection) return null;\n    const sizeClone = sizeSection.cloneNode(true);\n    const legend = sizeClone.querySelector('legend');\n    if (legend) {\n      const labelPart = legend.textContent.split(':')[0];\n      legend.textContent = labelPart + ':';\n    }\n    const groupName = sizeClone.querySelector('.product-form__group-name');\n    if (groupName) {\n      const labelPart = groupName.textContent.split(':')[0];\n      groupName.textContent = labelPart + ':';\n    }\n    return sizeClone;\n  }\n\n  const sizeChartSource = document.querySelector('.product-popup');\n  if (sizeChartSource) {\n    const sizeChartClone = sizeChartSource.cloneNode(true);\n    const popupChartTarget = variantPopup.querySelector('.popup-size-chart');\n    if (popupChartTarget) popupChartTarget.appendChild(sizeChartClone);\n  }\n\n  function preparePopupInputsAndListeners() {\n    const popupRadios = popupVariants.querySelectorAll('input[type=\"radio\"]');\n    popupRadios.forEach((radio, i) => {\n      const origName = radio.name || '';\n      const origValue = radio.value || '';\n      const origId = radio.id || `popup-radio-${i}`;\n      const newId = origId + '-popup-' + Math.random().toString(36).slice(2,6);\n      radio.dataset.originalName = origName;\n      radio.dataset.originalValue = origValue;\n      radio.id = newId;\n      const lbl = popupVariants.querySelector(`label[for=\"${origId}\"]`) || radio.nextElementSibling;\n      if (lbl && lbl.tagName === 'LABEL') lbl.setAttribute('for', newId);\n      radio.removeAttribute('name');\n      radio.addEventListener('change', function() {\n        const oName = this.dataset.originalName;\n        const oValue = this.dataset.originalValue;\n        const groupRadios = popupVariants.querySelectorAll(`input[data-original-name=\"${oName}\"]`);\n        groupRadios.forEach(r => { if (r !== this) r.checked = false; });\n        if (oName) {\n          const originalRadio = document.querySelector(`input[type=\"radio\"][name=\"${oName}\"][value=\"${oValue}\"]`);\n          if (originalRadio) {\n            originalRadio.checked = true;\n            originalRadio.dispatchEvent(new Event('change', { bubbles: true }));\n          }\n        }\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n        setTimeout(updatePopupButtonPrices, 100);\n      });\n    });\n\n    const popupSelects = popupVariants.querySelectorAll('select');\n    popupSelects.forEach((sel, i) => {\n      const origName = sel.name || '';\n      sel.dataset.originalName = origName;\n      const newId = (sel.id || `popup-select-${i}`) + '-popup-' + Math.random().toString(36).slice(2,6);\n      sel.id = newId;\n      sel.removeAttribute('name');\n      sel.addEventListener('change', function() {\n        const oName = this.dataset.originalName;\n        if (oName) {\n          const originalSelect = document.querySelector(`select[name=\"${oName}\"]`);\n          if (originalSelect) {\n            originalSelect.value = this.value;\n            originalSelect.dispatchEvent(new Event('change', { bubbles: true }));\n          }\n        }\n        setTimeout(updateStickyButtonState, 100);\n        setTimeout(updatePopupButtonState, 100);\n        setTimeout(updatePopupButtonPrices, 100);\n      });\n    });\n\n    const originalChecked = document.querySelectorAll('.product-form__controls input[type=\"radio\"]:checked');\n    originalChecked.forEach(orig => {\n      const popupMatch = popupVariants.querySelector(`input[data-original-name=\"${orig.name}\"][data-original-value=\"${orig.value}\"]`);\n      if (popupMatch) popupMatch.checked = true;\n    });\n    const originalSelects = document.querySelectorAll('.product-form__controls select');\n    originalSelects.forEach(os => {\n      const popupSel = popupVariants.querySelector(`select[data-original-name=\"${os.name}\"]`);\n      if (popupSel) popupSel.value = os.value;\n    });\n  }\n\n  function openVariantPopup() {\n    const sizeOptions = extractSizeOptions();\n    if (sizeOptions) {\n      popupVariants.innerHTML = '';\n      popupVariants.appendChild(sizeOptions);\n      preparePopupInputsAndListeners();\n    } else {\n      popupVariants.innerHTML = '<p style=\"text-align: center; padding: 20px; color: #666;\">Size options not available</p>';\n    }\n    variantPopup.classList.add('active');\n    document.body.style.overflow = 'hidden';\n    setTimeout(updatePopupButtonState, 100);\n    updatePopupButtonPrices();\n  }\n\n  function closeVariantPopup() {\n    variantPopup.classList.remove('active');\n    document.body.style.overflow = '';\n    setTimeout(updateStickyButtonState, 100);\n  }\n\n  popupOverlay.addEventListener('click', closeVariantPopup);\n  popupClose.addEventListener('click', closeVariantPopup);\n\n  popupAddToCart.addEventListener('click', function() {\n    if (!checkVariantAvailability()) return;\n    if (allVariantsSelected()) {\n      originalAddToCart.click();\n      closeVariantPopup();\n    } else {\n      popupVariants.classList.add('highlight-missing');\n      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);\n    }\n  });\n\n  popupBuyNow.addEventListener('click', function() {\n    if (!checkVariantAvailability()) return;\n    if (allVariantsSelected()) {\n      originalBuyNow.click();\n      closeVariantPopup();\n    } else {\n      popupVariants.classList.add('highlight-missing');\n      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);\n    }\n  });\n\n  if (stickyAddToCart && originalAddToCart) {\n    stickyAddToCart.addEventListener('click', function(e) {\n      e.preventDefault();\n      if (!checkVariantAvailability()) return;\n      if (!allVariantsSelected()) {\n        openVariantPopup();\n      } else {\n        originalAddToCart.click();\n      }\n    });\n  }\n\n  if (stickyBuyNow && originalBuyNow) {\n    stickyBuyNow.addEventListener('click', function(e) {\n      e.preventDefault();\n      if (!checkVariantAvailability()) {\n        openVariantPopup();\n        return;\n      }\n      if (!allVariantsSelected()) {\n        openVariantPopup();\n        return;\n      }\n      const qtyInput = document.querySelector('form.product-form input[name=\"quantity\"]');\n      if (qtyInput) qtyInput.value = 1;\n      const safeBuyNow = originalBuyNow.cloneNode(true);\n      originalBuyNow.parentNode.replaceChild(safeBuyNow, originalBuyNow);\n      safeBuyNow.click();\n    });\n  }\n\n  function wireOriginalToPopupSync() {\n    const originalRadios = document.querySelectorAll('.product-form__controls input[type=\"radio\"]');\n    originalRadios.forEach(r => {\n      r.addEventListener('change', function() {\n        if (!variantPopup.classList.contains('active')) return;\n        const p = popupVariants.querySelector(`input[data-original-name=\"${this.name}\"][data-original-value=\"${this.value}\"]`);\n        if (p) p.checked = true;\n      });\n    });\n    const originalSelects = document.querySelectorAll('.product-form__controls select');\n    originalSelects.forEach(s => {\n      s.addEventListener('change', function() {\n        if (!variantPopup.classList.contains('active')) return;\n        const p = popupVariants.querySelector(`select[data-original-name=\"${this.name}\"]`);\n        if (p) p.value = this.value;\n      });\n    });\n  }\n  wireOriginalToPopupSync();\n\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape' && variantPopup.classList.contains('active')) {\n      closeVariantPopup();\n    }\n  });\n});\n</script>\n\n\n<style>\n/* Sticky buttons */\n.sticky-product-form-buttons {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: #fff;\n  z-index: 99;\n  padding: 0;\n  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);\n  display: none;\n  transition: transform 0.3s ease, opacity 0.3s ease;\n}\n.sticky-buttons-row {\n    padding: 0px 15px;\n}\n\n.sticky-product-form-buttons.visible {\n  display: block;\n  opacity: 1;\n  transform: translateY(0);\n  padding-bottom: 15px;\n  padding-top: 15px;\n}\n.pay-img.stickyone {\n    background: transparent;\n    justify-content: center;\n    gap: 10px;\n    padding: 0;\n    margin-top: -5px;\n    align-items: center;\n    max-width: 100%;\n}\n.pay-img.stickyone p {\n    font-size: 9px;\n}\n.pay-img.stickyone img {\n    width: 40px;\nheight: 100%;\n}\n.sticky-product-form-buttons:not(.visible) {\n  opacity: 0;\n  transform: translateY(100%);\n}\n\n/* Out of Stock Styles */\n.sticky-buy-now-disabled,\n.popup-buy-now-disabled {\n  position: relative;\n  opacity: 0.6;\n  cursor: not-allowed !important;\n  pointer-events: none !important;\n}\n\n.sticky-buy-now-disabled::after,\n.popup-buy-now-disabled::after {\n  content: \"Out of Stock\";\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: rgba(0, 0, 0, 0.8);\n  color: white;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n.sticky-oos-error,\n.popup-oos-error {\n  background: #fff3f3;\n  border: 1px solid #ff4444;\n  color: #d00;\n  margin-bottom:10px;\n  border-radius: 5px;\n  font-size: 14px;\n  text-align: center;\n  display: none;\n  padding: 2px;\n}\n.popup-oos-error {\n    margin-bottom: 0px;\n    padding:2px 10px;\n}\n\n.sticky-oos-error.visible,\n.popup-oos-error.visible {\n  display: block;\n}\n\n/* Variant Popup */\n.variant-popup {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 10000;\n  display: none;\n}\n\n.variant-popup.active {\n  display: block;\n}\nspan.popup-btn-price {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n}\nspan.popup-btn-compare {\n    font-size: 13px;\n    font-weight: 100;\n    font-family: 'Inter';\ncolor: rgba(255, 255, 255, 0.7);\n}\nspan.popup-btn-current {\n    font-size: 18px;\n    font-family: 'Inter';\n}\n/* Price inside Buy Now button */\n\n/* Disabled state for sticky Add to Cart */\n.sticky-add-to-cart-disabled,\n.popup-add-to-cart-disabled {\n  position: relative;\n  opacity: 0.6;\n  cursor: not-allowed !important;\n  pointer-events: none !important;\n}\n.sticky-add-to-cart-disabled::after,\n.popup-add-to-cart-disabled::after {\n  content: \"Out of Stock\";\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: rgba(0, 0, 0, 0.8);\n  color: white;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  white-space: nowrap;\n  z-index: 2;\n}\n\n/* Disabled state for popup Add to Cart */\n.popup-add-to-cart-disabled {\n  position: relative;\n  opacity: 0.6;\n  cursor: not-allowed !important;\n  pointer-events: none !important;\n}\n.popup-add-to-cart-disabled::after {\n  content: \"Out of Stock\";\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: rgba(0, 0, 0, 0.8);\n  color: white;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  white-space: nowrap;\n  z-index: 2;\n}\n\n/* Sticky Add to Cart price */\n.sticky-add-to-cart-price {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-left: 6px;\n}\n.sticky-add-to-cart-price .current {\n  font-weight: 500;\n  font-size: 18px;\n  color: #5b3b22; /* matches your button text color */\n}\n.sticky-add-to-cart-price .compare {\n  font-size: 14px;\n  color: #5b3b22;\n  text-decoration: line-through;\n}\n\n/* Popup button prices */\n.popup-add-to-cart-price,\n.popup-buy-now-price {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-left: 6px;\n}\n.popup-add-to-cart-price .current,\n.popup-buy-now-price .current {\n  font-weight: 500;\n  font-size: 18px;\n  color: inherit; /* or specific color if needed */\n}\n.popup-add-to-cart-price .compare,\n.popup-buy-now-price .compare {\n  font-size: 14px;\n  color: rgba(0, 0, 0, 0.5);\n  text-decoration: line-through;\n}\n/* For Buy Now (red background) we want white text for current price */\n.popup-buy-now-price .current {\n  color: #fff;\n}\n.popup-buy-now-price .compare {\n  color: rgba(255, 255, 255, 0.7);\n}\n\n\n.sticky-btn-price {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-left: 6px;\n}\n\n.sticky-btn-current {\n  font-weight: 500;\n  font-size: 18px;\n  color: #fff; \norder: 2;\nfont-family: 'Inter';\n}\n\n.sticky-btn-compare {\n  font-size: 14px;\n  color: rgba(255, 255, 255, 0.7);\n  text-decoration: line-through;\nfont-weight: 500;\n    font-family: 'Inter';\n}\n.variant-popup__overlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n}\n\n.variant-popup__content {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: white;\n  border-radius: 12px 12px 0 0;\n  padding: 20px;\n  max-height: 80vh;\n  overflow-y: auto;\n  animation: slideUp 0.3s ease;\n}\n\n@keyframes slideUp {\n  from {\n    transform: translateY(100%);\n  }\n  to {\n    transform: translateY(0);\n  }\n}\n\n.variant-popup__header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n  padding-bottom: 15px;\n  border-bottom: 1px solid #e5e5e5;\n}\n\n.variant-popup__title-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  width: 100%;\n}\n\n.popup-size-chart .product-popup__button {\n  background: transparent;\n  border: none;\n  font-size: 13px;\n  color: #5b3b22;\n  padding: 0;\n  cursor: pointer;\n  position: initial;\n}\n.product-popup-modal[open]{\n    z-index: 99999;\n}\n.popup-size-chart .product-popup {\n    bottom: 0;\n    position: initial;\n    display: block;\n}\n.popup-size-chart svg {\n  width: 10px;\n  height: 10px;\n}\n\n.variant-popup__header h3 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 500;\ntext-transform: none;\n    font-family: 'Inter';\n}\n\n.variant-popup__close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.variant-popup__variants {\n  margin-bottom: 10px;\n}\n.size-txt {\n    font-family: 'Inter';\n    font-size: 13px;\n    font-weight: 400;\n}\n/* Style the variant options in popup */\n.variant-popup__variants .product-form__controls {\n  margin-bottom: 0;\n  border: none;\n  padding: 0;\n}\n\n.variant-popup__variants .product-form__group-name {\n  font-weight: 600;\n  margin-bottom: 12px;\n  display: block;\n  font-size: 16px;\n}\n\n.variant-popup__variants .product-form__controls-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.variant-popup__variants .product-form__input {\n  margin: 0;\n}\n\n.variant-popup__variants input[type=\"radio\"] {\n  display: none;\n}\n\n.variant-popup__variants input[type=\"radio\"] + label {\n  border: 1px solid #ddd;\n  padding: .6rem .8rem;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  font-size: 14px;\n  min-width: 50px;\n  text-align: center;\n}\n\n.variant-popup__variants input[type=\"radio\"]:checked + label {\n    color: #FFFFFF;\n    border-color: #000;\n    border-width: 1.5px;\n}\n\n.variant-popup__variants input[type=\"radio\"]:disabled + label {\n  opacity: 0.4;\n  cursor: not-allowed;\n  text-decoration: line-through;\n}\n\n.variant-popup__buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  margin-top: 20px;\n  align-items: center;\n  justify-content: center;\n}\n\n.variant-popup__content .pay-img.stickyone {\n    margin-top: 5px;\n}\n\n.variant-popup__buttons .button {\n    width: 100%;\n    padding: 9px 15px;\n    border: none;\n    border-radius: 5px;\n    font-weight: 500;\n    cursor: pointer;\n    font-size: 18px;\n    transition: all 0.2s ease;\n    display: flex;\n    align-items: center;\n    font-family: 'Inter';\n    justify-content: space-between;\n}\n\n.variant-popup__add-to-cart {\n  background: #000;\n  color: #fff;\n}\nbutton.button.button--secondary.variant-popup__buy-now {\n    display: none;\n}\n\n.variant-popup__add-to-cart:hover {\n  background: #333;\n}\n\n.variant-popup__buy-now {\n  background: #ff4444;\n  color: #fff;\n}\n\n.variant-popup__buy-now:hover {\n  background: #ff6666;\n}\nbutton.button.button--secondary.variant-popup__buy-now {\n    background: #e0a435;\n    color: white;\n    border: 2px solid #e0a435;\n}\nbutton.button.button--primary.variant-popup__add-to-cart {\n    background: transparent;\n    color: #5b3b22;\n    border: 2px solid #5b3b22;\n}\n.variant-popup__variants legend.product-form__group-name{\n    display: none;\n}\n.highlight-missing {\n  outline: 2px solid #ff4444;\n  border-radius: 8px;\n  padding: 15px;\n  animation: pulse 1s ease;\n}\n\n@keyframes pulse {\n  0% { outline-color: #ff4444; }\n  50% { outline-color: #ff8888; }\n  100% { outline-color: #ff4444; }\n}\n\n/* Hide Shopify accelerated checkout */\n.sticky-product-form-buttons .shopify-payment-button {\n  display: none !important;\n}\n\n/* Mobile-only */\n@media (min-width: 768px) {\n .sticky-product-form-buttons {\ndisplay:none !important;\n  }\n  .variant-popup__content {\n    max-width: 450px;\n    max-height: 600px;\n    border-radius: 12px;\n    bottom: auto;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    animation: popIn 0.3s ease;\n  }\n\n  @keyframes popIn {\n    from {\n      opacity: 0;\n      transform: translate(-50%, -40%);\n    }\n    to {\n      opacity: 1;\n      transform: translate(-50%, -50%);\n    }\n  }\n}\n</style>"
