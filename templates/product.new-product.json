        "custom_liquid_tBxii8": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const productButtons = document.querySelector('.product-form__buttons');\n  if (!productButtons) return;\n\n  // Clone sticky layout\nconst stickyClone = document.createElement('div');\nstickyClone.classList.add('sticky-product-form-buttons');\n\n// add wrapper for layout\nconst buttonWrapper = document.createElement('div');\nbuttonWrapper.classList.add('sticky-buttons-row');\nbuttonWrapper.appendChild(productButtons.cloneNode(true)); // only clone once\nstickyClone.appendChild(buttonWrapper);\n\n  // ➕ Add static payment info below sticky buttons\n  const payInfo = document.createElement('div');\n  payInfo.className = 'pay-img stickyone';\n  payInfo.innerHTML = `\n    <p>SECURE PAYMENTS</p>\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Frame_82_762039a6-bafc-4c49-aeee-d0cafde8d43f.png?v=1758952875\" width=\"100%\" height=\"auto\">\n  `;\n  stickyClone.appendChild(payInfo);\n\n  document.body.appendChild(stickyClone);\n\n  // Observe visibility\n  const observer = new IntersectionObserver(entries => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        stickyClone.classList.remove('visible');\n      } else {\n        stickyClone.classList.add('visible');\n      }\n    });\n  });\n  observer.observe(productButtons);\n\n  // Create popup element\n  const variantPopup = document.createElement('div');\n  variantPopup.className = 'variant-popup';\n  variantPopup.innerHTML = `\n    <div class=\"variant-popup__overlay\"></div>\n    <div class=\"variant-popup__content\">\n      <div class=\"variant-popup__header\">\n        <div class=\"variant-popup__title-row\">\n        <h3>Select Your Size</h3>\n        <div class=\"popup-size-chart\"></div>\n      </div>\n        <button class=\"variant-popup__close\">&times;</button>\n      </div>\n      <div class=\"variant-popup__variants\"></div>\n<div class=\"size-txt\">Make sure you’ve got the right size!</div>\n      <div class=\"variant-popup__buttons\">\n        <button class=\"button button--primary variant-popup__add-to-cart\">Add to Cart</button>\n        <button class=\"button button--secondary variant-popup__buy-now\">Buy Now\n         <span class=\"popup-btn-price\">\n          {% if product.compare_at_price > product.price %}\n            <span class=\"popup-btn-compare\"><del>{{ product.compare_at_price | money_without_trailing_zeros | replace: 'Rs.', '₹' }}</del></span>\n          {% endif %}\n          <span class=\"popup-btn-current\">{{ product.price | money_without_trailing_zeros | replace: 'Rs.', '₹' }}</span>\n        </span>\n        </button>\n      </div>\n      <div class=\"pay-img stickyone\">\n          <p>SECURE PAYMENTS</p>\n          <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Frame_82_762039a6-bafc-4c49-aeee-d0cafde8d43f.png?v=1758952875\" width=\"100%\" height=\"auto\">\n        </div>\n    </div>\n  `;\n  document.body.appendChild(variantPopup);\n\n  // Elements\n  const stickyAddToCart = stickyClone.querySelector('[name=\"add\"]');\n  const stickyBuyNow = stickyClone.querySelector('#gokwik-buy-now');\n  const originalAddToCart = productButtons.querySelector('[name=\"add\"]');\n  const originalBuyNow = productButtons.querySelector('#gokwik-buy-now');\n\n  // === Sticky Price inside Buy Now Button ===\n// === Sticky Price inside Buy Now Button ===\nfunction updateStickyButtonPrice() {\n  // Get current price (sale price)\n  const currentPriceEl = document.querySelector('.price-item--sale');\n  // Get compare price from the strikethrough element\n  const comparePriceEl = document.querySelector('.price__sale s.price-item--regular');\n  \n  if (!currentPriceEl || !stickyBuyNow) return;\n\n  // Remove any old price spans first\n  const oldPrice = stickyBuyNow.querySelector('.sticky-btn-price');\n  if (oldPrice) oldPrice.remove();\n\n  // Get and clean price texts\n  const currentPriceText = currentPriceEl.textContent.trim().replace(/Rs\\.?\\s*/gi, '₹').replace(/\\.00\\b/g, '');\n  let comparePriceText = '';\n  \n  if (comparePriceEl) {\n    comparePriceText = comparePriceEl.textContent.trim().replace(/Rs\\.?\\s*/gi, '₹').replace(/\\.00\\b/g, '');\n  }\n\n  // Build new price markup\n  let html = `<span class=\"sticky-btn-price\">`;\n  \n  // Only show compare price if it exists and is different from current price\n  if (comparePriceText && comparePriceText !== currentPriceText) {\n    html += `<span class=\"sticky-btn-compare\">${comparePriceText}</span>`;\n  }\n  \n  html += `<span class=\"sticky-btn-current\">${currentPriceText}</span>`;\n  html += `</span>`;\n\n  // Append after Buy Now text\n  stickyBuyNow.insertAdjacentHTML('beforeend', html);\n}\n\n// Initial update\nupdateStickyButtonPrice();\n\n// Watch for price changes\nconst priceContainer = document.querySelector('.price');\nif (priceContainer) {\n  const priceObserver = new MutationObserver(updateStickyButtonPrice);\n  priceObserver.observe(priceContainer, { \n    childList: true, \n    subtree: true, \n    characterData: true \n  });\n}\n\n// Also observe variant changes\nconst variantInputs = document.querySelectorAll('.product-form__input input, .product-form__controls select');\nvariantInputs.forEach(input => {\n  input.addEventListener('change', updateStickyButtonPrice);\n});\n  // Popup elements\n  const popupOverlay = variantPopup.querySelector('.variant-popup__overlay');\n  const popupClose = variantPopup.querySelector('.variant-popup__close');\n  const popupVariants = variantPopup.querySelector('.variant-popup__variants');\n  const popupAddToCart = variantPopup.querySelector('.variant-popup__add-to-cart');\n  const popupBuyNow = variantPopup.querySelector('.variant-popup__buy-now');\n\n  // Helper: check if all variants selected (checks the real/original form only)\n  function allVariantsSelected() {\n    // Check selects\n    const selects = document.querySelectorAll('.product-form__controls select');\n    for (const s of selects) {\n      if (!s.value) return false;\n    }\n\n    // Check radio groups by unique name\n    const radioInputs = document.querySelectorAll('.product-form__controls input[type=\"radio\"]');\n    const radioNames = [...new Set(Array.from(radioInputs).map(r => r.name).filter(Boolean))];\n    for (const name of radioNames) {\n      const checked = document.querySelector(`.product-form__controls input[type=\"radio\"][name=\"${name}\"]:checked`);\n      if (!checked) return false;\n    }\n\n    return true;\n  }\n\n  // Find size section (same as before)\n  function findSizeVariantSection() {\n    const variantSections = document.querySelectorAll('.product-form__controls');\n    for (const section of variantSections) {\n      const legend = section.querySelector('legend');\n      if (legend) {\n        const legendText = legend.textContent.toLowerCase();\n        if (legendText.includes('size') || legendText.includes('sizes')) return section;\n      }\n      const groupName = section.querySelector('.product-form__group-name');\n      if (groupName) {\n        const groupText = groupName.textContent.toLowerCase();\n        if (groupText.includes('size') || groupText.includes('sizes')) return section;\n      }\n    }\n    return variantSections[0] || null;\n  }\n\n  // Clone & cleanup size options for popup\n  function extractSizeOptions() {\n    const sizeSection = findSizeVariantSection();\n    if (!sizeSection) {\n      console.log('No size section found');\n      return null;\n    }\n    const sizeClone = sizeSection.cloneNode(true);\n\n    // Keep only label part of legend/groupname\n    const legend = sizeClone.querySelector('legend');\n    if (legend) {\n      const labelPart = legend.textContent.split(':')[0];\n      legend.textContent = labelPart + ':';\n    }\n    const groupName = sizeClone.querySelector('.product-form__group-name');\n    if (groupName) {\n      const labelPart = groupName.textContent.split(':')[0];\n      groupName.textContent = labelPart + ':';\n    }\n\n    return sizeClone;\n  };\n\n  // Clone Size Chart button from PDP into popup\nconst sizeChartSource = document.querySelector('.product-popup');\nif (sizeChartSource) {\n  const sizeChartClone = sizeChartSource.cloneNode(true);\n  const popupChartTarget = variantPopup.querySelector('.popup-size-chart');\n  if (popupChartTarget) popupChartTarget.appendChild(sizeChartClone);\n};\n  // Make popup inputs independent and wire sync listeners\n  function preparePopupInputsAndListeners() {\n    // Radios\n    const popupRadios = popupVariants.querySelectorAll('input[type=\"radio\"]');\n    popupRadios.forEach((radio, i) => {\n      const origName = radio.name || '';\n      const origValue = radio.value || '';\n      // ensure unique id and update label 'for' inside popup\n      const origId = radio.id || `popup-radio-${i}`;\n      const newId = origId + '-popup-' + Math.random().toString(36).slice(2,6);\n      radio.dataset.originalName = origName;\n      radio.dataset.originalValue = origValue;\n      radio.id = newId;\n\n      // update label inside popup that referenced the original id (if any)\n      const lbl = popupVariants.querySelector(`label[for=\"${origId}\"]`) || radio.nextElementSibling;\n      if (lbl && lbl.tagName === 'LABEL') lbl.setAttribute('for', newId);\n\n      // remove name to prevent browser grouping with page radios (this was the root cause)\n      radio.removeAttribute('name');\n\n      // add change listener to sync popup -> original\nradio.addEventListener('change', function() {\n  const oName = this.dataset.originalName;\n  const oValue = this.dataset.originalValue;\n\n  // 🔹 Uncheck other popup radios from the same option group\n  const groupRadios = popupVariants.querySelectorAll(`input[data-original-name=\"${oName}\"]`);\n  groupRadios.forEach(r => {\n    if (r !== this) {\n      r.checked = false;\n    }\n  });\n\n  // 🔹 Sync selection with the original variant input\n  if (oName) {\n    const originalRadio = document.querySelector(`input[type=\"radio\"][name=\"${oName}\"][value=\"${oValue}\"]`);\n    if (originalRadio) {\n      originalRadio.checked = true;\n      originalRadio.dispatchEvent(new Event('change', { bubbles: true }));\n    }\n  }\n});\n\n    });\n\n    // Selects (if your variant uses select dropdown)\n    const popupSelects = popupVariants.querySelectorAll('select');\n    popupSelects.forEach((sel, i) => {\n      const origName = sel.name || '';\n      sel.dataset.originalName = origName;\n      const newId = (sel.id || `popup-select-${i}`) + '-popup-' + Math.random().toString(36).slice(2,6);\n      sel.id = newId;\n      sel.removeAttribute('name');\n      sel.addEventListener('change', function() {\n        const oName = this.dataset.originalName;\n        if (oName) {\n          const originalSelect = document.querySelector(`select[name=\"${oName}\"]`);\n          if (originalSelect) {\n            originalSelect.value = this.value;\n            originalSelect.dispatchEvent(new Event('change', { bubbles: true }));\n          }\n        }\n      });\n    });\n\n    // Sync initial selection from original form -> popup UI\n    const originalChecked = document.querySelectorAll('.product-form__controls input[type=\"radio\"]:checked');\n    originalChecked.forEach(orig => {\n      const popupMatch = popupVariants.querySelector(`input[data-original-name=\"${orig.name}\"][data-original-value=\"${orig.value}\"]`);\n      if (popupMatch) popupMatch.checked = true;\n    });\n    // selects\n    const originalSelects = document.querySelectorAll('.product-form__controls select');\n    originalSelects.forEach(os => {\n      const popupSel = popupVariants.querySelector(`select[data-original-name=\"${os.name}\"]`);\n      if (popupSel) popupSel.value = os.value;\n    });\n  }\n\n  // Opens popup\n  function openVariantPopup() {\n    const sizeOptions = extractSizeOptions();\n    if (sizeOptions) {\n      popupVariants.innerHTML = '';\n      popupVariants.appendChild(sizeOptions);\n\n      // IMPORTANT: make popup radios/selects independent and add listeners\n      preparePopupInputsAndListeners();\n\n    } else {\n      popupVariants.innerHTML = '<p style=\"text-align: center; padding: 20px; color: #666;\">Size options not available</p>';\n    }\n\n    variantPopup.classList.add('active');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function closeVariantPopup() {\n    variantPopup.classList.remove('active');\n    document.body.style.overflow = '';\n  }\n\n  // Popup button handlers\n  popupOverlay.addEventListener('click', closeVariantPopup);\n  popupClose.addEventListener('click', closeVariantPopup);\n\n  popupAddToCart.addEventListener('click', function() {\n    if (allVariantsSelected()) {\n      originalAddToCart.click();\n      closeVariantPopup();\n    } else {\n      popupVariants.classList.add('highlight-missing');\n      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);\n    }\n  });\n\n  popupBuyNow.addEventListener('click', function() {\n    if (allVariantsSelected()) {\n      originalBuyNow.click();\n      closeVariantPopup();\n    } else {\n      popupVariants.classList.add('highlight-missing');\n      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);\n    }\n  });\n\n  // Sticky handlers\n  if (stickyAddToCart && originalAddToCart) {\n    stickyAddToCart.addEventListener('click', function(e) {\n      e.preventDefault();\n      if (!allVariantsSelected()) openVariantPopup();\n      else originalAddToCart.click();\n    });\n  }\n\n if (stickyBuyNow && originalBuyNow) {\n  stickyBuyNow.addEventListener('click', function(e) {\n    e.preventDefault();\n\n    if (!allVariantsSelected()) {\n      openVariantPopup();\n      return;\n    }\n\n    // Reset quantity to 1 to avoid carryover\n    const qtyInput = document.querySelector('form.product-form input[name=\"quantity\"]');\n    if (qtyInput) qtyInput.value = 1;\n\n    // Clone Buy Now to clear duplicate event handlers\n    const safeBuyNow = originalBuyNow.cloneNode(true);\n    originalBuyNow.parentNode.replaceChild(safeBuyNow, originalBuyNow);\n\n    // Trigger the clean Buy Now click\n    safeBuyNow.click();\n  });\n}\n\n\n  // Keep popup UI updated if original form changes while popup is open\n  function wireOriginalToPopupSync() {\n    // radios\n    const originalRadios = document.querySelectorAll('.product-form__controls input[type=\"radio\"]');\n    originalRadios.forEach(r => {\n      r.addEventListener('change', function() {\n        if (!variantPopup.classList.contains('active')) return;\n        const p = popupVariants.querySelector(`input[data-original-name=\"${this.name}\"][data-original-value=\"${this.value}\"]`);\n        if (p) p.checked = true;\n      });\n    });\n    // selects\n    const originalSelects = document.querySelectorAll('.product-form__controls select');\n    originalSelects.forEach(s => {\n      s.addEventListener('change', function() {\n        if (!variantPopup.classList.contains('active')) return;\n        const p = popupVariants.querySelector(`select[data-original-name=\"${this.name}\"]`);\n        if (p) p.value = this.value;\n      });\n    });\n  }\n  wireOriginalToPopupSync();\n\n  // Close popup with Escape\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape' && variantPopup.classList.contains('active')) {\n      closeVariantPopup();\n    }\n  });\n});\n</script>\n\n\n<style>\n/* Sticky buttons */\n.sticky-product-form-buttons {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: #fff;\n  z-index: 99;\n  padding: 0;\n  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);\n  display: none;\n  transition: transform 0.3s ease, opacity 0.3s ease;\n}\n.sticky-buttons-row {\n    padding: 0px 15px;\n}\n\n.sticky-product-form-buttons.visible {\n  display: block;\n  opacity: 1;\n  transform: translateY(0);\n  padding-bottom: 15px;\n  padding-top: 15px;\n}\n.pay-img.stickyone {\n    background: transparent;\n    justify-content: center;\n    gap: 10px;\n    padding: 0;\n    margin-top: -5px;\n    align-items: center;\n    max-width: 100%;\n}\n.pay-img.stickyone p {\n    font-size: 9px;\n}\n.pay-img.stickyone img {\n    width: 40px;\n}\n.sticky-product-form-buttons:not(.visible) {\n  opacity: 0;\n  transform: translateY(100%);\n}\n\n/* Variant Popup */\n.variant-popup {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 10000;\n  display: none;\n}\n\n.variant-popup.active {\n  display: block;\n}\nspan.popup-btn-price {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n}\nspan.popup-btn-compare {\n    font-size: 13px;\n    font-family: 'Inter';\ncolor: rgba(255, 255, 255, 0.7);\n}\nspan.popup-btn-current {\n    font-size: 18px;\n    font-family: 'Inter';\n}\n/* Price inside Buy Now button */\n.sticky-btn-price {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-left: 6px;\n}\n\n.sticky-btn-current {\n  font-weight: 500;\n  font-size: 18px;\n  color: #fff; \norder: 2;\nfont-family: 'Inter';\n}\n\n.sticky-btn-compare {\n  font-size: 14px;\n  color: rgba(255, 255, 255, 0.7);\n  text-decoration: line-through;\nfont-weight: 500;\n    font-family: 'Inter';\n}\n.variant-popup__overlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n}\n\n.variant-popup__content {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: white;\n  border-radius: 12px 12px 0 0;\n  padding: 20px;\n  max-height: 80vh;\n  overflow-y: auto;\n  animation: slideUp 0.3s ease;\n}\n\n@keyframes slideUp {\n  from {\n    transform: translateY(100%);\n  }\n  to {\n    transform: translateY(0);\n  }\n}\n\n.variant-popup__header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n  padding-bottom: 15px;\n  border-bottom: 1px solid #e5e5e5;\n}\n\n.variant-popup__title-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  width: 100%;\n}\n\n.popup-size-chart .product-popup__button {\n  background: transparent;\n  border: none;\n  font-size: 13px;\n  color: #5b3b22;\n  padding: 0;\n  cursor: pointer;\n  position: initial;\n}\n.product-popup-modal[open]{\n    z-index: 99999;\n}\n.popup-size-chart .product-popup {\n    bottom: 0;\n    position: initial;\n    display: block;\n}\n.popup-size-chart svg {\n  width: 10px;\n  height: 10px;\n}\n\n.variant-popup__header h3 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 500;\ntext-transform: none;\n    font-family: 'Inter';\n}\n\n.variant-popup__close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.variant-popup__variants {\n  margin-bottom: 10px;\n}\n.size-txt {\n    font-family: 'Inter';\n    font-size: 13px;\n    font-weight: 400;\n}\n/* Style the variant options in popup */\n.variant-popup__variants .product-form__controls {\n  margin-bottom: 0;\n  border: none;\n  padding: 0;\n}\n\n.variant-popup__variants .product-form__group-name {\n  font-weight: 600;\n  margin-bottom: 12px;\n  display: block;\n  font-size: 16px;\n}\n\n.variant-popup__variants .product-form__controls-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.variant-popup__variants .product-form__input {\n  margin: 0;\n}\n\n.variant-popup__variants input[type=\"radio\"] {\n  display: none;\n}\n\n.variant-popup__variants input[type=\"radio\"] + label {\n  border: 1px solid #ddd;\n  padding: .6rem .8rem;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  font-size: 14px;\n  min-width: 50px;\n  text-align: center;\n}\n\n.variant-popup__variants input[type=\"radio\"]:checked + label {\n    color: #e0a435;\n    border-color: #e0a435;\n    border-width: 1.5px;\n}\n\n.variant-popup__variants input[type=\"radio\"]:disabled + label {\n  opacity: 0.4;\n  cursor: not-allowed;\n  text-decoration: line-through;\n}\n\n.variant-popup__buttons {\n  display: flex;\n  flex-direction: row;\n  gap: 10px;\n  margin-top: 20px;\n  align-items: center;\n    justify-content: center;\n}\n\n.variant-popup__content .pay-img.stickyone {\n    margin-top: 5px;\n}\n\n.variant-popup__buttons .button {\n    width: 50%;\n    padding: 9px 15px;\n    border: none;\n    border-radius: 5px;\n    font-weight: 500;\n    cursor: pointer;\n    font-size: 18px;\n    transition: all 0.2s ease;\n    display: flex;\n    align-items: center;\n    font-family: 'Inter';\n}\n\n.variant-popup__add-to-cart {\n  background: #000;\n  color: #fff;\n}\nbutton.button.button--primary.variant-popup__add-to-cart {\n    display: none;\n}\n.variant-popup__buttons .button{\n    width: 100%;\n    justify-content: space-between;\n}\n.variant-popup__add-to-cart:hover {\n  background: #333;\n}\n\n.variant-popup__buy-now {\n  background: #ff4444;\n  color: #fff;\n}\n\n.variant-popup__buy-now:hover {\n  background: #ff6666;\n}\nbutton.button.button--secondary.variant-popup__buy-now {\n    background: #e0a435;\n    color: white;\n    border: 2px solid #e0a435;\n}\nbutton.button.button--primary.variant-popup__add-to-cart {\n    background: transparent;\n    color: #5b3b22;\n    border: 2px solid #5b3b22;\n}\n.variant-popup__variants legend.product-form__group-name{\n    display: none;\n}\n.highlight-missing {\n  outline: 2px solid #ff4444;\n  border-radius: 8px;\n  padding: 15px;\n  animation: pulse 1s ease;\n}\n\n@keyframes pulse {\n  0% { outline-color: #ff4444; }\n  50% { outline-color: #ff8888; }\n  100% { outline-color: #ff4444; }\n}\n\n/* Hide Shopify accelerated checkout */\n.sticky-product-form-buttons .shopify-payment-button {\n  display: none !important;\n}\n\n/* Mobile-only */\n@media (min-width: 768px) {\n  .sticky-product-form-buttons {\ndisplay:none !important;\n  }\n  \n  .variant-popup__content {\n    max-width: 450px;\n    max-height: 600px;\n    border-radius: 12px;\n    bottom: auto;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    animation: popIn 0.3s ease;\n  }\n  \n  @keyframes popIn {\n    from {\n      opacity: 0;\n      transform: translate(-50%, -40%);\n    }\n    to {\n      opacity: 1;\n      transform: translate(-50%, -50%);\n    }\n  }\n}\n</style>"
