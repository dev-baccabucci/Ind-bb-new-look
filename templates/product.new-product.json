      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Benefits Section -->\n <div class=\"main-benefits\">\n<div class=\"benefits\">\n  <div class=\"benefit-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Truck.png?v=1759215802\" alt=\"Free Shipping\">\n    <p>FREE SHIPPING<br> PAN INDIA</p>\n  </div>\n  <div class=\"benefit-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/ShieldStar_1.png?v=1759215803\" alt=\"Warranty\">\n    <p>1-MONTH<br> WARRANTY</p>\n  </div>\n  <div class=\"benefit-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/KeyReturn.png?v=1759215803\" alt=\"Returns\">\n    <p>NO QUESTIONS<br> ASKED RETURNS</p>\n  </div>\n  <div class=\"benefit-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Headset.png?v=1759215803\" alt=\"Support\">\n    <p>24/7 CUSTOMER<br> SUPPORT</p>\n  </div>\n</div>\n</div>\n\n<style>\n.benefits {\n    display: flex;\n    justify-content: space-between;\n    gap: 11px;\n    padding: 20px 20px;\n        border-bottom:1px solid #e5e5e5;\n}\n\n.benefit-item {\n  text-align: center;\n  font-family: Arial, sans-serif;\n  color: #333;\n  display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n.benefit-item img {\n  width: 35px;\n  height: 35px;\n  margin-bottom: 8px;\n  filter: invert(20%); /* makes icons dark like screenshot */\n}\n\n.benefit-item p {\n    font-size: 10px;\n    font-weight: 500;\n    line-height: 1.4;\n    margin: 0;\n    text-transform: uppercase;\n    font-family: Inter;\n}\n\n@media (min-width: 768px) {\n.benefit-item p\n {\n    font-size: 15px;\n}\n.benefits {\n    padding-right: 5rem;\n    padding-left: 2rem;\n    max-width: 924px;\n    margin: 0 auto;\n\n}\n.main-benefits{\n    border-bottom: 2px solid #ddd;\n}\n}\n</style>"
      }
    },
    "custom_liquid_NiVrGe": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% if product.metafields.custom.a_plus_content.value != blank %}\n\n<section class=\"a-plus-content-wrapper\">\n  <div class=\"page-width\">\n\n    {% for media in product.metafields.custom.a_plus_content.value %}\n\n      <div class=\"a-plus-block\">\n\n        {% if media.media_type == 'image' %}\n\n          <img\n            src=\"{{ media | image_url: width: 2000 }}\"\n            alt=\"{{ media.alt | escape }}\"\n            loading=\"lazy\"\n            width=\"{{ media.width }}\"\n            height=\"{{ media.height }}\"\n            class=\"a-plus-image\"\n          >\n\n        {% elsif media.media_type == 'video' %}\n\n          {{\n            media\n            | video_tag:\n              autoplay: false,\n              loop: false,\n              muted: false,\n              controls: true,\n              class: 'a-plus-video'\n          }}\n\n        {% endif %}\n\n      </div>\n\n    {% endfor %}\n\n  </div>\n</section>\n\n<style>\n\n.a-plus-content-wrapper{\n  padding: 40px 0;\n}\n\n.a-plus-block{\n  overflow: hidden;\n}\n\n.a-plus-image{\n  width: 100%;\n  display: block;\nheight:auto;\n}\n\n.a-plus-video{\n  width: 100%;\n  display: block;\n  border-radius: 16px;\n}\n\n@media screen and (max-width: 768px){\n\n  .a-plus-content-wrapper{\n    padding: 24px 0;\n  }\n\n\n}\n\n</style>\n\n{% endif %}"
      }
    },
    "custom_liquid_TYFcac": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"revtitle\">\n<p>Latest Reviews</p>\n</div>\n<div id=\"looxReviews\" data-product-id=\"{{product.id}}\" class=\"loox-reviews-default\"></div>\n\n<style>\nbutton#write {\n    border-radius: 8px !important;\n}\n#grid .grid-item {\n    border-radius: 8px !important;\n}\n.revtitle {\n    padding-left: 10px;\n    max-width: 1200px;\n    margin: 0 auto;\n    margin-top: 30px;\n    margin-bottom: -12px;\n    font-family: 'Roboto';\n    font-weight: 700;\n    font-style: Italic;\n    font-size: 2.4rem;\n    line-height: 120%;\n    letter-spacing: 0%;\n}\ndiv#looxReviews {\n    padding-left: 10px;\npadding-right:10px\n}\nbutton#write {\n    border-color: #000;\n}\n</style>"
