    <style>
        :root { --bb-red: #E11B22; --bb-bg: #E6E6E6; --bb-text: #000000; --bb-divider: #b3b3b3; }
        
        /* 1. LOCK BACKGROUND SCROLL PROPERLY */
        body.bb-menu-open { overflow: hidden !important; }

        /* 2. USE 'dvh' FOR MOBILE BROWSER ADDRESS BARS */
        .bb-mega-drawer { 
            position: fixed; 
            top: 53px; 
            left: 0; 
            width: 100%; 
            /* Fallback to vh, use dvh if supported for perfect mobile sizing */
            height: calc(100vh - var(--header-height, 80px)); 
            height: calc(100dvh - var(--header-height, 80px)); 
            background: var(--bb-bg); 
            z-index: 990; 
            transform: translateY(-100%); 
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s; 
            display: flex; 
            flex-direction: column; 
            opacity:0; 
            overflow: scroll; 
        }
        .bb-menu-open .bb-mega-drawer { transform: translateY(0); opacity: 1; }
        
        /* 3. INTERNAL SCROLLING FIXED */
        .bb-drawer-content { 
            display: grid; 
            grid-template-columns: 280px 1fr; 
            gap: 40px; 
            flex-grow: 1; /* Takes up remaining height */
            padding: 40px 60px; 
            transition: grid-template-columns 0.4s ease; 
            
            -webkit-overflow-scrolling: touch; /* Smooth iOS scroll */
            overscroll-behavior: contain; /* Stops background from scrolling when reaching the bottom */
        }
        
        .bb-drawer-content.step-2 { grid-template-columns: 280px 280px 1fr; }
        .bb-menu-col { padding-right: 10px; }
        #bbCol2 { display: none; }
        .bb-drawer-content.step-2 #bbCol2 { display: block; }
        .bb-nav-item { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; font-size: 13px; font-weight: 600; color: var(--bb-text); cursor: pointer; border-bottom: 1px solid var(--bb-divider); transition: 0.2s; text-decoration: none;}
        .bb-nav-item:hover, .bb-nav-item.active { color: var(--bb-red); }
        .bb-nav-item span.bb-arrow { font-size: 16px; font-weight: 400; display:flex; align-items:center; }
        .bb-visual-area { display: grid; gap: 25px; align-items: start; width: 100%; }
        .bb-gallery-3 { grid-template-columns: repeat(3, 1fr); }
        .bb-gallery-2 { grid-template-columns: repeat(2, 1fr); }
        .bb-promo-card { text-decoration: none; color: black; display: flex; flex-direction: column; }
        .bb-img-wrap { width: 100%; aspect-ratio: 4/5; overflow: hidden; margin-bottom: 15px; background: #ccc; }
        .bb-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
        .bb-view-more { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; color: #000; margin-top: 5px; }
        .bb-red-circle { width: 18px; height: 18px; background: var(--bb-red); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 10px; }
        .bb-l3-list { display: none; column-count: 3; column-gap: 40px; width: 100%; }
        .bb-l3-list.active { display: block; }
        .bb-l3-item { display: block; padding: 10px 0; color: #000; text-decoration: none; font-size: 14px; font-weight: 500;}
        .bb-l3-item:hover { color: var(--bb-red); }
        .bb-menu-col::-webkit-scrollbar { width: 4px; }
        .bb-menu-col::-webkit-scrollbar-thumb { background: #bbb; border-radius: 4px; }
        .shopify-section-header-sticky, sticky-header.header-wrapper { z-index: 9999 !important; }
        .bb-desktop-utilities { display: none;}

        /* Hide Mobile Elements on Desktop */
        .bb-mobile-back, .bb-mobile-black-bar { display: none; }
        header-drawer {
    display: none;
}
        /* ==========================================
           📱 MOBILE RESPONSIVE OPTIMIZATIONS 
           ========================================== */
        @media screen and (max-width: 989px) {
            .bb-drawer-content { display: flex; flex-direction: column; padding: 0; }
            .bb-menu-col { padding: 0 20px; width: 100%; flex-shrink: 0; }
            
            /* Mobile Black Header Bar */
            .bb-mobile-black-bar { display: flex; flex-shrink: 0; background: #000; padding: 12px 20px; gap: 20px; white-space: nowrap; -webkit-overflow-scrolling: touch; justify-content:center;}
            .bb-mobile-black-bar a { color: #fff; font-size: 12px; font-weight: 600; text-decoration: none; text-transform: uppercase; }
            
            .bb-desktop-utilities { display: none; }

            /* Drill-down Logic for Menu Items */
            #bbCol1 { display: block; }
            .bb-drawer-content.step-2 #bbCol1, .bb-drawer-content.step-3 #bbCol1 { display: none; }
            .bb-drawer-content.step-2 #bbCol2 { display: block; }
            .bb-drawer-content.step-3 #bbCol2 { display: none; }
            
            /* MOBILE CAROUSEL STYLES (The 1.3 Ratio) */
            #bbRightSideContainer { display: block !important; padding: 20px 20px 40px 20px; width: 100%; overflow: hidden; }
            
            .bb-visual-area { 
                display: flex !important; 
                flex-wrap: nowrap; 
                overflow-x: auto; 
                gap: 15px; 
                scroll-snap-type: x mandatory; 
                -webkit-overflow-scrolling: touch; 
                scrollbar-width: none; 
                padding-bottom: 10px;
            }
            .bb-visual-area::-webkit-scrollbar { display: none; }
            
            .bb-promo-card { 
                width: 75%; 
                flex-shrink: 0; 
                scroll-snap-align: start; 
            }

            /* Hide Carousel in Step 3 */
            .bb-drawer-content.step-3 .bb-visual-area { display: none !important; }
            .bb-drawer-content.step-3 #bbL3List { display: block !important; }
            
            /* Mobile Nav Styling */
            .bb-nav-item { font-size: 16px; padding: 22px 0; border-bottom: 1px solid #99999940; }
            .bb-l3-list { column-count: 1; margin-top: 10px; }
            .bb-l3-title { display: none; }
            .bb-l3-item { font-size: 16px; padding: 20px 0; border-bottom: 1px solid #99999940; }

            /* Mobile Back Button */
            .bb-mobile-back {
                display: flex; align-items: center; justify-content: center;
                background: var(--bb-red); color: white; padding: 16px; margin: 20px 0 10px 0;
                font-weight: 600; font-size: 16px; border-radius: 4px; cursor: pointer; position: relative; text-transform: uppercase;
            }
            .bb-mobile-back svg { position: absolute; left: 15px; }
        }

        .bb-menu-trigger.mobile-hemburger-menu {
    margin: 0;
    display: none;
}

@media screen and (max-width: 767px) {
   .bb-menu-trigger.mobile-hemburger-menu {
    display: flex;
}
    .bb-menu-trigger.desktop-hemburger-menu {
    display: none !important;
}
}

    </style>

    <script>
        const bbDiscoveryImages = [];
        const bbMenuData = {};

        {%- if block.settings.main_menu != blank -%}
            {%- for link in block.settings.main_menu.links -%}
                bbMenuData['{{ forloop.index }}'] = {
                    title: {{ link.title | json }},
                    step2Imgs: [],
                    subs: [
                        {%- for sub_link in link.links -%}
                            {
                                name: {{ sub_link.title | json }},
                                link: {{ sub_link.url | json }},
                                hasL3: {% if sub_link.links.size > 0 %}true{% else %}false{% endif %},
                                l3: [
                                    {%- for l3_link in sub_link.links -%}
                                        { name: {{ l3_link.title | json }}, link: {{ l3_link.url | json }} }{% unless forloop.last %},{% endunless %}
                                    {%- endfor -%}
                                ]
                            }{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                    ]
                };
            {%- endfor -%}
        {%- endif -%}

        // MAPPING IMAGES 1 TO 10
        {% for i in (1..10) %}
            {% capture img %}img_{{ i }}{% endcapture %}
            {% capture title %}title_{{ i }}{% endcapture %}
            {% capture link %}link_{{ i }}{% endcapture %}
            {% capture assign %}assign_{{ i }}{% endcapture %}
            
            {% if block.settings[img] != blank %}
                var imgObj = { 
                    img: {{ block.settings[img] | image_url: width: 800 | json }}, 
                    title: {{ block.settings[title] | json }}, 
                    link: {{ block.settings[link] | json }} 
                };
                if ({{ block.settings[assign] | json }} === 'default') {
                    bbDiscoveryImages.push(imgObj);
                } else if (bbMenuData[{{ block.settings[assign] | json }}]) {
                    bbMenuData[{{ block.settings[assign] | json }}].step2Imgs.push(imgObj);
                }
            {% endif %}
        {% endfor %}

        const bbBody = document.body;
        const bbLayout = document.getElementById('bbDrawerLayout');
        const bbVisualArea = document.getElementById('bbVisualArea');
        const bbL3List = document.getElementById('bbL3List');

        function toggleBBDrawer() {
            if (bbBody.classList.contains('bb-menu-open')) {
                bbBody.classList.remove('bb-menu-open');
                // FIX 1: Update ALL trigger icons (Desktop and Mobile)
                document.querySelectorAll('.bb-menu-trigger').forEach(el => el.classList.remove('active-trigger'));
                resetBBDrawer();
            } else {
                bbBody.classList.add('bb-menu-open');
                // FIX 1: Update ALL trigger icons (Desktop and Mobile)
                document.querySelectorAll('.bb-menu-trigger').forEach(el => el.classList.add('active-trigger'));
                renderBBGallery(bbDiscoveryImages, bbDiscoveryImages.length >= 3 ? 3 : 2); 
            }
        }

        function resetBBDrawer() {
            document.querySelectorAll('.bb-nav-item').forEach(i => i.classList.remove('active'));
            bbLayout.classList.remove('step-2', 'step-3');
            bbL3List.classList.remove('active');
            bbVisualArea.style.display = ''; 
            bbLayout.scrollTop = 0; // Reset scroll position when closed
        }

        function openBBL2(key, el) {
            const data = bbMenuData[key];
            if(!data) return;

            document.querySelectorAll('.bb-menu-col:first-child .bb-nav-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');

            bbLayout.classList.add('step-2');
            bbLayout.classList.remove('step-3');
            bbL3List.classList.remove('active');
            
            bbVisualArea.style.display = ''; 
            renderBBGallery(data.step2Imgs, 2);

            let html = `
                <div class="bb-mobile-back" onclick="closeBBL2(event)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
                    ${data.title.toUpperCase()}
                </div>
            `;
            html += data.subs.map(sub => `
                <div class="bb-nav-item" onclick="handleBBL2Click('${key}', '${sub.name.replace(/'/g, "\\'")}', this, '${sub.link}')">
                    ${sub.name.toUpperCase()} 
                    ${sub.hasL3 ? '<span class="bb-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></span>' : ''}
                </div>
            `).join('');

            document.getElementById('bbSubList').innerHTML = html;
            bbLayout.scrollTop = 0; // Scroll to top when opening sub menu
        }

        function closeBBL2(e) {
            if(e) e.stopPropagation();
            bbLayout.classList.remove('step-2');
            document.querySelectorAll('.bb-menu-col:first-child .bb-nav-item').forEach(i => i.classList.remove('active'));
            
            // FIX 2: Reload the default 3 images when clicking back
            renderBBGallery(bbDiscoveryImages, bbDiscoveryImages.length >= 3 ? 3 : 2); 
        }

        function handleBBL2Click(mainKey, subName, el, redirectLink) {
            const subData = bbMenuData[mainKey].subs.find(s => s.name === subName);
            document.querySelectorAll('#bbSubList .bb-nav-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');

            if (subData.hasL3) {
                bbVisualArea.style.display = 'none';
                bbLayout.classList.add('step-3'); 
                bbL3List.classList.add('active');
                
                let l3Html = `
                    <div class="bb-mobile-back" onclick="closeBBL3(event)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
                        ${subName.toUpperCase()}
                    </div>
                `;
                l3Html += subData.l3.map(item => `
                    <a href="${item.link}" class="bb-l3-item">${item.name.toUpperCase()}</a>
                `).join('');

                document.getElementById('bbL3Content').innerHTML = l3Html;
                bbLayout.scrollTop = 0; // Scroll to top when opening tertiary menu
            } else {
                window.location.href = redirectLink;
            }
        }

        function closeBBL3(e) {
            if(e) e.stopPropagation();
            bbLayout.classList.remove('step-3');
            bbL3List.classList.remove('active');
            bbVisualArea.style.display = ''; 
        }

        function renderBBGallery(items, cols) {
            bbVisualArea.className = `bb-visual-area bb-gallery-${cols}`;
            if(items.length === 0) { bbVisualArea.innerHTML = ''; return; }
            bbVisualArea.innerHTML = items.map(item => `
                <a href="${item.link}" class="bb-promo-card">
                    <div class="bb-img-wrap"><img src="${item.img}" alt="${item.title}"></div>
                    <div class="bb-view-more">${item.title} <div class="bb-red-circle">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
                    </div></div>
                </a>
            `).join('');
        }
    </script>
  {%- endif -%}
{%- endfor -%}

