{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

<div class="newsletter section-{{ section.id }}-padding">
  <div class="container">
    <div class="newsletter__inner newsletter__inner--{{ section.settings.align_content }}">
      {%- if section.settings.image != blank -%}
        <div class="img-text">
        {%- capture sizes -%}
          (min-width: 1100px) 1920px, calc((100vw - 20px))
        {%- endcapture -%}
        {{
          section.settings.image
          | image_url: width: 956
          | image_tag: loading: 'lazy', sizes: sizes, widths: '360, 535, 720, 956', class: 'newsletter__image'
        }}
        </div>
      {%- endif -%}
      <div class="newsletter__form">
        {% render 'heading-group', section: section, class: 'newsletter', text_align: section.settings.text_align %}

        <div class="content">
          {% form 'customer', class: 'newsletter-form' %}
            <div class="newsletter-form__inner">
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form__field-wrapper">
                <div class="form-field">
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input field"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="{{- 'newsletter.label' | t -}}"
                    required
                  >
                  <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                    {{- 'newsletter.label' | t -}}
                  </label>
                </div>
                <div class="field">
  <input
    id="NewsletterPhone--{{ section.id }}"
    type="tel"
    name="contact[phone]"
    class="field__input field"
    pattern="[0-9]{10}"
    aria-required="true"
    autocomplete="tel"
    placeholder="Phone number"
    required
  >
  <label class="visually-hidden" for="NewsletterPhone--{{ section.id }}">
    Phone number
  </label>
</div>
   </div>             
<div class="footer-subscribe-form-checkbox">
                          <input
                            type="checkbox"
                            name="footer_newsletter_checkbox"
                            id="footer_newsletter_checkbox"
                            required
                            oninvalid="this.classList.add('is-invalid')"
                            onchange="this.classList.remove('is-invalid')"
                          >
                          <label
                            class="footer-subscribe-form-checkbox__label new"
                            for="footer_newsletter_checkbox"
                          >
                            <span class="footer-subscribe-form-checkbox__label-text body-small">
                               I agree to get updates, offers & promos via SMS, RCS & WhatsApp
                            </span>
                          </label>
   <p class="footer-news-form-checkbox__error">
                            This field is required
                          </p>
                        </div>

                {%- if form.errors -%}
                  <small
                    class="newsletter-form__message form__message"
                    id="Newsletter-error--{{ section.id }}"
                  >
                    {%- render 'icon-error' -%}
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              <button
                type="submit"
                class="newsletter__button button button--{{ section.settings.button_style }} focus-inset"
                name="commit"
              >
                <div class="button__content">
                  <span class="button__label" data-label="{{- 'newsletter.button_label' | t -}}">
                    {{- 'newsletter.button_label' | t -}}
                  </span>
                </div>
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <h3
                class="newsletter-form__message newsletter-form__message--success form__message"
                id="Newsletter-success--{{ section.id }}"
                tabindex="-1"
                autofocus
              >
                {% render 'icon-success' -%}
                {{- 'newsletter.success' | t }}
              </h3>
            {%- endif -%}
          {% endform %}
          {%- if section.settings.newsletter_text -%}
            <div class="newsletter__text body-small {{ section.settings.text_align }}">
              {{- section.settings.newsletter_text -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .newsletter__inner.newsletter__inner--left {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 500px;
}
.img-text {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
}
.img-text img {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}
.newsletter__form {
    background: rgb(245 245 239 / 86%);
    margin-left: auto;
    margin-right: auto;
    width: 50%;
    margin-right: inherit;
    opacity: 1;
    z-index: 9;
    padding: 30px;
}
  .newsletter .newsletter-form__inner {
    flex-direction: column !important;
}
  button.newsletter__button.button.button--primary.focus-inset {
    background: #dca23f;
}
  .field input[type=text], .field input[type=email], .field input[type=tel], .field .field__input {
    flex-grow: 1;
    padding: 0.2rem 1.6rem;
    text-align: left;
    border-color: black;
}
.footer-subscribe-form-checkbox__label.new:before {
    content: "";
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 1px solid black;
    background-color: transparent;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 4px;
}
  .footer-news-form-checkbox__error {
    display: none;
    padding: 0.4rem 0.8rem;
    color: red;
    font-weight: medium;
    background-color: #fff;
    border-radius: 4px;
    border: 1px solid rgba(var(--color-border-input));
    position: absolute;
    left: -3px;
    top: calc(-140% + 4px);
    font-size: 11px;
}
.footer-news-form-checkbox__error::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    background-color: #fff;
    border-left: 1px solid rgba(var(--color-border-input));
    border-top: 1px solid rgba(var(--color-border-input));
    transform: rotate(-136deg);
    transform-origin: 0 0;
    border-top-left-radius: 1px;
    z-index: 10;
    position: absolute;
    top: 28px;
    left: 10px;
}
.footer-subscribe-form-checkbox input[type=checkbox].is-invalid ~ .footer-news-form-checkbox__error {
  display: block;
}
  .field {
    padding: 5px;
}
   .newsletter__form {
    margin-top: 0px;
    }
  .form-field {
    display: flex;
    flex-direction: column;
}
  .newsletter .container {
    max-width: 1440px;
}
  .newsletter__description.description.description--center {
    text-align: left;
    margin-bottom: 10px;
margin-left: 10px;
    margin-top:10px;
}
.newsletter__titles.titles.titles--center {
    text-align: left;
}
h2.newsletter__title.title.h3.size--h3 {
    margin-left: 10px;
}
  @media screen and (max-width: 576px) {
     .newsletter__inner.newsletter__inner--left {
    min-height: 365px;
}
    .newsletter__form {
    width: 100%;
    }
    .newsletter__form {
    margin-top: 0px;
      border-radius: 10px;
    }
      .footer-news-form-checkbox__error {
    top: calc(-70% + 4px);
}
  }
</style>
{% schema %}
{
  "name": "Newsletter New",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.newsletter.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
     {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.all.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "div",
          "label": "div"
        },
        {
          "value": "p",
          "label": "p"
        },
        {
          "value": "span",
          "label": "span"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "default": "center"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_text",
      "label": "t:sections.newsletter.settings.newsletter_text.label",
      "default": "t:sections.newsletter.settings.newsletter_text.default"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "select",
      "id": "align_content",
      "options": [
        {
          "value": "left",
          "label": "t:sections.newsletter.settings.align_content.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.newsletter.settings.align_content.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.newsletter.settings.align_content.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "Newsletter New"
    }
  ]
}
{% endschema %}
