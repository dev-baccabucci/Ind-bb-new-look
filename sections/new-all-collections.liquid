<!-- Swiper JS -->

<script>
(function initMySwiperSafe() {
  // 1️⃣ Wait until Swiper JS is actually available
  if (typeof Swiper === 'undefined') {
    setTimeout(initMySwiperSafe, 50);
    return;
  }

  const swiperElement = document.querySelector('.mySwiper');
  if (!swiperElement || swiperElement.classList.contains('swiper-initialized')) {
    return;
  }

  // 2️⃣ Initialize Swiper
  const swiper = new Swiper(swiperElement, {
    lazy: true,
    slidesPerView: 3,
    spaceBetween: 10,
    loop: false,
    autoplay: false,

    navigation: {
      nextEl: '.for-coll-next',
      prevEl: '.for-coll-prev',
    },

    breakpoints: {
      640: {
        slidesPerView: 4,
        spaceBetween: 5,
      },
      768: {
        slidesPerView: 4,
        spaceBetween: 5,
      },
      1024: {
        slidesPerView: 5,
        spaceBetween: 5,
      },
    },

    on: {
      slideChange: function () {
        if (this.isEnd) {
          setTimeout(() => {
            this.slideTo(0, 0);
          }, 1000);
        }
      },
      slidePrevTransitionStart: function () {
        if (this.activeIndex === 0) {
          this.slideTo(0, 0);
        }
      }
    }
  });

  // 3️⃣ IntersectionObserver for autoplay
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          swiper.params.autoplay = {
            delay: 3000,
            disableOnInteraction: false,
          };
          swiper.autoplay.start();
        } else {
          swiper.autoplay.stop();
        }
      });
    }, { threshold: 0.3 });

    observer.observe(swiperElement);
  }

})();
</script>


