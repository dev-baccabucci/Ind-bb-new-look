<!-- Swiper Slider Section -->
<header style="margin-bottom: 10px;" class="section__header text-container">
    <h3 class="heading h2">All CATEGORIES</h3>
  </header>
  
<div class="space-div">
<div class="swiper mySwiper">
  <div class="swiper-wrapper coll-wrap">
    {% for block in section.blocks %}
      <div class="swiper-slide">
        <a href="{{ block.settings.slide_link }}" class="slide-content">
<picture>
  <source media="(min-width: 768px)" srcset="{{ block.settings.slide_image_desktop | img_url: 'master' }}">
  <source media="(max-width: 767px)" srcset="{{ block.settings.slide_image_mobile | img_url: 'master' }}">
  <img src="{{ block.settings.slide_image_desktop | image_url: 'master', width: block.settings.image.width, height: image_height, preload: true, fetchpriority: 'high' }}" style="width:100%; height:auto; object-fit: cover;" alt="All Categories" loading="eager">
</picture>

          <div class="slide-text">
            <h3>{{ block.settings.slide_title }}</h3>
            <!-- <p>{{ block.settings.slide_text }}</p> -->
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="swiper-button-next for-coll-next"> <img src="https://cdn.shopify.com/s/files/1/0279/5133/3450/files/right-arrow-icon-1.png?v=1740817334" width="35px"> </div>
    <div class="swiper-button-prev for-coll-prev"> <img src="https://cdn.shopify.com/s/files/1/0279/5133/3450/files/left-arrow-icon-1.png?v=1740817335" width="35px"> </div>
  <!-- <div class="swiper-pagination for-coll"></div> -->
</div>
</div>

