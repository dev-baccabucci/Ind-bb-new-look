<style>
  .explore-range-section {
    --bg-color: #d9d9d9;
    --accent-color: #000;
    --track-color: #d1d1d1;
    --transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    padding: 30px 0;
    background-color: var(--bg-color);
  }
  .explore-range-section .section-title {
    font-size: 5.4rem;
    font-style: italic;
    margin-bottom: 10px;
    text-transform:capitalize;
    font-weight:600;
    letter-spacing: -0.03em;
  }
  .explore-range-section .card-heading {
    display: none;
  }
  /* DESKTOP TABS */
  .explore-range-section .tab-wrapper {
    display: flex;
    justify-content: space-between;
    position: relative;
    margin-bottom: 60px;
  }
  .explore-range-section .tab-wrapper:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 6px;
    background: #c6c6c6;
    border-radius: 10px;
  }
  .explore-range-section .tab-btn {
    background: none;
    border: none;
    padding: 15px 0;
    font-size: 15px;
    font-weight: 700;
    color: #888;
    cursor: pointer;
    position: relative;
    transition: color 0.4s ease;
    text-align: left;
  }
  .explore-range-section .tab-btn.active {
    color: var(--accent-color);
  }
  .explore-range-section .tab-btn.hide-on-desktop {
    display: none;
  }
  .explore-range-section .tab-btn span {
    position: relative;
    padding-bottom: 15px;
  }
  .explore-range-section .tab-btn span::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 5px;
    background-color: var(--accent-color);
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    border-radius: 50px;
    z-index: 9;
  }
  .explore-range-section .tab-btn.active span::after {
    width: 100%;
  }
  /* GRID & FLEX LAYOUT */
  .explore-range-section .explore-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 500px;
  }
  .explore-range-section .explore-card {
    display: none;
    position: relative;
    transition: var(--transition);
    cursor: pointer;
    overflow: hidden;
    flex-direction: column;
    flex: 0 0 auto;
  }
  .explore-range-section .explore-card.is-visible {
    display: flex;
  }
  .explore-range-section .explore-card.is-active {
    flex: 0 0 45%;
  }
  .explore-range-section .explore-card.is-visible:not(.is-active) {
    flex: 0 0 25%;
  }
  @media (min-width: 769px) {
    .explore-range-section .explore-card.hide-on-desktop {
      display: none !important;
    }
  }
  .explore-range-section .image-box {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    overflow: hidden;
    background-color: #ddd;
    position: relative;
  }
  /* The picture element and img fill the box */
  .explore-range-section .image-box picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .explore-range-section .image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s ease;
  }
  .explore-range-section .card-content {
    margin-top: 15px;
  }
  .explore-range-section .view-more {
    text-decoration: none;
    color: #000;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 1em;
  }
  .explore-range-section .circle-arrow {
    width: 20px;
    height: 20px;
  }
  span.button_label_more {
    position: relative;
    display: inline-block;
  }
  .explore-range-section .button_label_more:after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 1px;
    bottom: 0px;
    left: 0;
    background-color: rgb(0, 0, 0);
    transform-origin: bottom right;
    transition: transform 0.25s ease-out;
  }
  .explore-range-section .button_label_more:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  /* MOBILE OPTIMIZATION — static 2x2 grid */
  @media (max-width: 768px) {
    .explore-range-section .tab-wrapper {
      display: none;
    }
    .explore-range-section .explore-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      height: auto;
      align-items: stretch;
    }
    .explore-range-section .explore-card {
      display: flex !important;
      width: 100% !important;
      flex: none !important;
      order: 0 !important;
      height: auto !important;
    }
    .explore-range-section .explore-card.hide-on-mobile {
      display: none !important;
    }
    .explore-range-section .image-box {
      aspect-ratio: 2/3;
    }
    /* Scrim so the heading/button stay readable over any image */
    .explore-range-section .image-box::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.35) 0%,
        rgba(0, 0, 0, 0) 30%,
        rgba(0, 0, 0, 0) 65%,
        rgba(0, 0, 0, 0.5) 100%
      );
    }
    /* Heading overlaid on top of the card image */
    .explore-range-section .card-heading {
      display: block;
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      z-index: 2;
      font-family: 'Inter';
      font-style: italic;
      font-weight: 700;
      font-size: 1.6rem;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      color: #fff;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);
      text-align: center;
    }
    /* View more button overlaid at the bottom of the card image */
    .explore-range-section .card-content {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 10px;
      z-index: 2;
      margin-top: 0;
      display: flex;
      justify-content: center;
    }
    .explore-range-section .view-more {
        color: #fff;
        background: #111111;
        border-radius: 4px;
        padding: 6px 10px;
        gap: 6px;
        font-size: 0.8rem;
    }
    .explore-range-section .circle-arrow {
      width: 12px;
      height: 12px;
      filter: invert(1) brightness(2);
    }
    .explore-range-section .section-title {
      font-size: 2.5rem;
      margin-bottom: 20px;
    }
  }
</style>

<div class="explore-range-section" data-section-id="{{ section.id }}" data-section-type="explore-range">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <nav class="tab-wrapper">
      {% for block in section.blocks %}
        <button class="tab-btn {% if forloop.first %}active{% endif %}{% if block.settings.hide_on_desktop %} hide-on-desktop{% endif %}" data-index="{{ forloop.index0 }}" data-block-id="{{ block.id }}">
          <span>{{ block.settings.title | escape }}</span>
        </button>
      {% endfor %}
    </nav>

    <div class="explore-range-wrapper-{{ section.id }}">
      <div class="explore-grid">
        {% for block in section.blocks %}
          {% assign img_url = block.settings.image | img_url: '800x' %}
          {% assign link_url = block.settings.link | default: '#' %}
          {% assign button_text_view = block.settings.button_lable %}

          {%- comment -%}
            Mobile image: use mobile_image if set, otherwise fall back to desktop image.
            The <source media="(max-width: 768px)"> tells the browser to use the
            mobile URL on small screens; the <img> fallback is used on desktop.
          {%- endcomment -%}
          {% if block.settings.mobile_image != blank %}
            {% assign mobile_img_url = block.settings.mobile_image | img_url: '600x' %}
          {% else %}
            {% assign mobile_img_url = img_url %}
          {% endif %}

          {% assign card_classes = 'explore-card' %}
          {% if block.settings.hide_on_mobile %}{% assign card_classes = card_classes | append: ' hide-on-mobile' %}{% endif %}
          {% if block.settings.hide_on_desktop %}{% assign card_classes = card_classes | append: ' hide-on-desktop' %}{% endif %}

          <div class="{{ card_classes }}" data-index="{{ forloop.index0 }}" data-title="{{ block.settings.title | escape }}">
            <div class="card-heading">{{ block.settings.title | escape }}</div>
            <div class="image-box">
              {% if block.settings.image != blank or block.settings.mobile_image != blank %}
                <picture>
                  {%- comment -%} Mobile source — shown on screens ≤ 768px {%- endcomment -%}
                  <source media="(max-width: 768px)" srcset="{{ mobile_img_url }}">
                  {%- comment -%} Desktop fallback img {%- endcomment -%}
                  <img
                    src="{{ img_url }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                  >
                </picture>
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="card-content">
              <a href="{{ link_url }}" class="view-more">
                <span class="button_label_more">{{ button_text_view }}</span>
                <span class="circle-arrow">
                  <img src="https://cdn.shopify.com/s/files/1/0279/5133/3450/files/View_more_icon_d280f222-97aa-4fbf-8a5e-4c94b2001893.png?v=1776338595" height="100%" width="100%">
                </span>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    {%- comment -%}
      Mobile now renders as a static CSS grid (2x2) showing every card that
      isn't flagged "Hide on mobile" — no carousel/JS involved there.
      This script only drives the desktop tab-rotation behaviour, and skips
      any card/tab flagged "Hide on desktop" when rotating.
    {%- endcomment -%}
    function initExploreRangeSection(sectionEl) {
      if (sectionEl.dataset.exploreInitialized === 'true') return;
      sectionEl.dataset.exploreInitialized = 'true';

      const tabs = Array.from(sectionEl.querySelectorAll('.tab-btn'));
      const cards = Array.from(sectionEl.querySelectorAll('.explore-card'));
      const desktopIndices = cards.reduce((acc, card, idx) => {
        if (!card.classList.contains('hide-on-desktop')) acc.push(idx);
        return acc;
      }, []);
      let currentActiveIndex = desktopIndices[0] || 0;

      function applyDesktopLayout(activeIndex) {
        const total = desktopIndices.length;
        if (total === 0) return;
        const pos = desktopIndices.indexOf(activeIndex);
        const startPos = pos === -1 ? 0 : pos;
        let visibleIndices = [desktopIndices[startPos]];
        if (total > 1) visibleIndices.push(desktopIndices[(startPos + 1) % total]);
        if (total > 2) visibleIndices.push(desktopIndices[(startPos + 2) % total]);
        visibleIndices = [...new Set(visibleIndices)];
        cards.forEach((card, idx) => {
          card.classList.remove('is-visible', 'is-active');
          card.style.flex = '';
          if (visibleIndices.includes(idx)) {
            card.classList.add('is-visible');
            if (idx === activeIndex) card.classList.add('is-active');
          }
        });
        const visibleCards = cards.filter(c => c.classList.contains('is-visible'));
        const visibleCount = visibleCards.length;
        if (visibleCount === 1) {
          visibleCards.forEach(card => { card.style.flex = '0 0 100%'; });
        } else if (visibleCount === 2) {
          visibleCards.forEach(card => {
            card.style.flex = card.classList.contains('is-active') ? '0 0 55%' : '0 0 40%';
          });
        } else {
          visibleCards.forEach(card => {
            card.style.flex = card.classList.contains('is-active') ? '0 0 45%' : '0 0 25%';
          });
        }
        cards.forEach((card, idx) => {
          if (visibleIndices.includes(idx)) {
            const position = visibleIndices.indexOf(idx);
            card.style.order = idx === activeIndex ? '-1' : position;
          } else {
            card.style.order = '10';
          }
        });
      }

      function setActiveTabUI(activeIndex) {
        tabs.forEach((tab, idx) => {
          tab.classList.toggle('active', idx === activeIndex);
        });
      }

      function bindTabEvents() {
        tabs.forEach((tab, idx) => {
          if (tab.classList.contains('hide-on-desktop')) return;
          tab.removeEventListener('click', tab._clickHandler);
          tab._clickHandler = () => {
            const newIndex = parseInt(tab.dataset.index, 10);
            if (isNaN(newIndex) || !desktopIndices.includes(newIndex)) return;
            currentActiveIndex = newIndex;
            setActiveTabUI(currentActiveIndex);
            applyDesktopLayout(currentActiveIndex);
          };
          tab.addEventListener('click', tab._clickHandler);
        });
      }

      setActiveTabUI(currentActiveIndex);
      applyDesktopLayout(currentActiveIndex);
      bindTabEvents();

      if (window.Shopify && window.Shopify.designMode) {
        const observer = new MutationObserver(() => {
          const newCards = Array.from(sectionEl.querySelectorAll('.explore-card'));
          const newTabs = Array.from(sectionEl.querySelectorAll('.tab-btn'));
          if (newCards.length !== cards.length || newTabs.length !== tabs.length) location.reload();
        });
        observer.observe(sectionEl, { childList: true, subtree: true });
      }
    }

    function initAllSections() {
      document.querySelectorAll('.explore-range-section').forEach(section => {
        if (!section.dataset.exploreInitialized) initExploreRangeSection(section);
      });
    }

    initAllSections();
    if (window.Shopify && window.Shopify.section) {
      document.addEventListener('shopify:section:load', function(event) {
        const section = event.target;
        if (section.classList && section.classList.contains('explore-range-section')) {
          initExploreRangeSection(section);
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Explore Range",
  "class": "explore-range",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Range"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category Tab",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Card Image (Mobile)",
          "info": "Optional. If not set, the desktop image will be used on mobile too."
        },
        {
          "type": "url",
          "id": "link",
          "label": "View More Link",
          "info": "Link for the 'View more' button"
        },
        {
          "type": "text",
          "id": "button_lable",
          "label": "Button Lable",
          "default": "Category"
        },
        {
          "type": "checkbox",
          "id": "hide_on_mobile",
          "label": "Hide on mobile",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "hide_on_desktop",
          "label": "Hide on desktop",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore Range",
      "blocks": [
        { "type": "tab", "settings": { "title": "Active shoes" } },
        { "type": "tab", "settings": { "title": "Sneaker" } },
        { "type": "tab", "settings": { "title": "Adventure" } },
        { "type": "tab", "settings": { "title": "Belts & Wallets" } },
        { "type": "tab", "settings": { "title": "Oversized Tshirt" } }
      ]
    }
  ]
}
{% endschema %}