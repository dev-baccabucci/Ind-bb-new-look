{% for block in section.blocks limit:1 %}
  {% if forloop.first %}
    <link rel="preload" as="image"
      href="{{ block.settings.image | image_url: width: 1920 }}"
      imagesrcset="{{ block.settings.image | image_url: width: 768 }} 768w,
                   {{ block.settings.image | image_url: width: 1280 }} 1280w,
                   {{ block.settings.image | image_url: width: 1440 }} 1440w,
                    {{ block.settings.image | image_url: width: 1920 }} 1920w"
      imagesizes="100vw"
      media="(min-width: 481px)">

    <link rel="preload" as="image"
      href="{{ block.settings.image1 | image_url: width: 768 }}"
      imagesrcset="{{ block.settings.image1 | image_url: width: 375 }} 375w,
                   {{ block.settings.image1 | image_url: width: 640 }} 640w,
                   {{ block.settings.image1 | image_url: width: 768 }} 768w"
      imagesizes="100vw"
      media="(max-width: 480px)">
  {% endif %}
{% endfor %}

{% comment %} {{ 'swiper-bundle.min06.css' | asset_url | stylesheet_tag: preload: true }} {% endcomment %}
 <link rel="stylesheet" href="{{ 'swiper-bundle.min06.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'swiper-bundle.min06.css' | asset_url }}"></noscript>
  
<div class="swiper-container">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {% assign is_first = forloop.first %}

      <div class="swiper-slide slds" style="cursor: pointer;" onclick="window.location='{{ block.settings.button_link }}';">
        <div class="slide-content">
            <picture>
              <source
                media="(max-width: 480px)"
                srcset="{{ block.settings.image1 | image_url: width: 375 }} 375w,
                        {{ block.settings.image1 | image_url: width: 640 }} 640w,
                        {{ block.settings.image1 | image_url: width: 768 }} 768w"
                sizes="100vw">
              <source
                media="(min-width: 481px)"
                srcset="{{ block.settings.image | image_url: width: 768 }} 768w,
                        {{ block.settings.image | image_url: width: 1280 }} 1280w,
                        {{ block.settings.image | image_url: width: 1440 }} 1440w,
                         {{ block.settings.image | image_url: width: 1920 }} 1920w"
                sizes="100vw">
              <img
                src="{{ block.settings.image | image_url: width: 1920 }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                sizes="100vw"
                alt="Hero banner"
                class="slide-img"
              {% if is_first %}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              {% else %}
                loading="lazy"
                decoding="async"
              {% endif %}
          >
            </picture>

          <div class="slide-text"></div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="swiper-pagination"></div>
</div>

<style>
  .swiper-slide.slds:hover { transform: none; }
  .swiper-slide.slds { width: 100% !important; }
  .slide-content { width: 100%; height: 100%; }
  .slide-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .swiper-container {
    padding: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  @media screen and (max-width: 480px) {
    .swiper-container { height: 100%; }
  }
  .swiper-pagination { height: 40px; }
  .swiper-pagination-bullet {
    background-color: transparent;
    border: solid 1px white;
    opacity: 1;
    transition: all 0.3s ease-in-out;
  }
  .swiper-pagination-bullet:hover { background-color: white; }
  .swiper-pagination-bullet-active {
    width: 20px;
    border-radius: 50px;
    background-color: transparent;
    border: solid 1px white;
    transition: all 0.3s ease-in-out;
  }
  .slide-text {
    text-align: center;
    color: white;
    z-index: 2;
    width: 80%;
    max-width: 500px;
  }
  .slide-text h1 { font-size: 30px; letter-spacing: 0.03em; font-weight: 600; }
  .slide-text p { font-size: 16px; }
  @media screen and (max-width: 768px) {
    .slide-text { width: 60%; }
    .slide-text h1 { font-size: 20px; letter-spacing: 0.02em; }
    .slide-text p { font-size: 14px; }
  }
  .slide-text .btn {
    background-color: transparent;
    border: solid 1px black;
    padding: 15px 30px;
    min-width: 100px;
    width: fit-content;
    font-size: 14px;
    letter-spacing: 2px;
    color: black;
    position: relative;
    border-radius: 80px;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
    margin-top: 20px;
    font-weight: 800;
  }
  .slide-text .btn:after {
    content: '';
    background-color: rgba(255,255,255,0.1);
    width: 100%; height: 100%;
    display: block; position: absolute;
    z-index: 2; left: 0; top: 0;
    border-radius: inherit;
    transition: all 0.3s ease-in-out;
  }
  .slide-text .btn:hover::after { left: 4px; top: 5px; background-color: rgba(255,255,255,0.3); }
  @media screen and (max-width: 768px) {
    .slide-text .btn:hover::after { left: 0; top: 0; background-color: rgba(255,255,255,0.1); }
  }
  button:focus { outline: 0; }
</style>

<script>
  function initHeroSwiper() {
    document.querySelectorAll('.swiper-container').forEach(container => {
      if (container.classList.contains('swiper-initialized')) return;
      new Swiper(container, {
        slidesPerView: 1,
        loop: container.querySelectorAll('.swiper-slide').length > 1,
        autoplay: { delay: 2500 },
        pagination: {
          el: container.querySelector('.swiper-pagination'),
          clickable: true
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initHeroSwiper);
  document.addEventListener('shopify:section:load', initHeroSwiper);
</script>

{% schema %}
{
  "name": "Custom Slideshow",
  "settings": [],
  "presets": [
    {
      "name": "Custom Slideshow",
      "category": "Custom"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image desktop"
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "Slide image mobile"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ]
}
{% endschema %}