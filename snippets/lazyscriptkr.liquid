{% comment %} <script>
  // Define scripts and styles to be lazy-loaded
  const scriptUrls = [
    'https://loox.io/widget/EkZpQIDJv9/loox.1619425036871.js?shop=baccabucci.myshopify.com',
    'https://zooomyapps.com/backinstock/ZooomyOrders.js?shop=baccabucci.myshopify.com',
    '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit',
    'https://cdn.shopify.com/extensions/0a399711-e52d-4a4f-97ae-1534575ede67/popcoins-loyalty-baccabucci-82/assets/pop-club-embed.js',
    'https://cdn.shopify.com/extensions/0a399711-e52d-4a4f-97ae-1534575ede67/popcoins-loyalty-baccabucci-82/assets/jquery-3.6.3.min.js',
    'https://checkout-merchant.snapmint.com/js/v1/2057'
  ];

  const styleUrls = [
    'https://cdn.shopify.com/extensions/0a399711-e52d-4a4f-97ae-1534575ede67/popcoins-loyalty-baccabucci-82/assets/floating-popcoin.css'
  ];

  let assetsLoaded = false;

  function loadAssetsOnce() {
    if (assetsLoaded) return;
    assetsLoaded = true;

    // Load JS
    scriptUrls.forEach(url => {
      const script = document.createElement('script');
      script.src = url;
      script.async = true;
      document.body.appendChild(script);
    });

    // Load CSS
    styleUrls.forEach(url => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = url;
      document.head.appendChild(link);
    });

    // Remove event listeners
    ['click', 'touchstart', 'scroll'].forEach(event => {
      document.removeEventListener(event, loadAssetsOnce);
    });
  }

  // Attach once-only event listeners
  ['click', 'touchstart', 'scroll'].forEach(event => {
    document.addEventListener(event, loadAssetsOnce, { once: true });
  });
</script> {% endcomment %}

