<div class="new-btn-section">
{%  if collection.metafields.custom.sub_collections.value != blank %}
  {%  assign lCollections  =  collection.metafields.custom.sub_collections.value %}
<div class="button-content">
  {%  for col in lCollections  %}
     <a href="{{ col.url }}" class="btn">
    <div class="coll-list">
<div class="button-text">
{% if col.title == "Bacca Bucci Sneakers" %}
Shop Sneakers
  {% comment %} {% elsif col.title == "Bacca Bucci Casuals Shoes" %}
Casuals {% endcomment %}
  {% elsif col.title == "Bacca Bucci Sports and Athleisure footwear"%}
  Shop Sports
  {% elsif col.title == "Bacca Bucci Boots"%}
  Shop Boots
  {% else %}
  {{ col.title }}
  {% endif %}
</div>
</div>
     </a>
  {% endfor %}
</div>
{%  endif %}
 </div>

<style>

  @font-face {
  font-family: 'Montserrat';
  src: url('https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Montserrat-VariableFont_wght.ttf') format('ttf');  
  font-style: normal;
  }
  
