<script>
{% comment %} function validateVariantSelection(form) {
  if (!form) return false;

  const variantInput = form.querySelector('input[name="id"]');

  if (!variantInput || !variantInput.value) {
    const productForm = form.closest('.product-form');
    const errorBox = productForm?.querySelector(
      '.product-form__error-message-wrapper'
    );

    if (errorBox) {
      errorBox.hidden = false;
    }

    return false;
  }

  return true;
}


document.addEventListener('submit', function (e) {
  const form = e.target.closest('form[data-type="add-to-cart-form"]');
  if (!form) return;

  if (!validateVariantSelection(form)) {
    e.preventDefault();
    e.stopImmediatePropagation();
  }
});


window.handleBuyNowClick = function (btn, formSelector) {
  const form = document.querySelector(formSelector);
  if (!form) return;

  if (!validateVariantSelection(form)) {
    return; // ❌ Stop GoKwik
  }

  // ✅ Variant selected → proceed
  if (typeof goKwikBuyNow === 'function') {
    goKwikBuyNow(btn, formSelector);
  }
}; {% endcomment %}


(function () {
  /**
   * Show variant error
   */
  function showVariantError(form) {
    const productForm = form.closest('.product-form');
    const errorBox = productForm?.querySelector(
      '.product-form__error-message-wrapper'
    );

    if (errorBox) {
      errorBox.hidden = false;
    }
  }

  /**
   * Hide variant error
   */
  function hideVariantError(form) {
    const productForm = form.closest('.product-form');
    const errorBox = productForm?.querySelector(
      '.product-form__error-message-wrapper'
    );

    if (errorBox) {
      errorBox.hidden = true;
    }
  }

  /**
   * Validate variant selection
   */
  function isVariantSelected(form) {
    const variantInput = form.querySelector('input[name="id"]');
    return !!(variantInput && variantInput.value);
  }

  /**
   * INTERCEPT ADD TO CART (PDP + QUICK VIEW)
   * Capture mode prevents Quick View from closing
   */
  document.addEventListener(
    'submit',
    function (e) {
      const form = e.target.closest('form[data-type="add-to-cart-form"]');
      if (!form) return;

      if (!isVariantSelected(form)) {
        e.preventDefault();
        e.stopImmediatePropagation();
        showVariantError(form);
        return false;
      }

      hideVariantError(form);
    },
    true // 👈 IMPORTANT
  );

  /**
   * INTERCEPT GOKWIK BUY NOW
   */
  window.handleBuyNowClick = function (btn, formSelector) {
    const form = document.querySelector(formSelector);
    if (!form) return;

    if (!isVariantSelected(form)) {
      showVariantError(form);
      return;
    }

    hideVariantError(form);

    // Force variant sync for GoKwik
    const variantInput = form.querySelector('input[name="id"]');
    variantInput.dispatchEvent(new Event('change', { bubbles: true }));

    // Small delay so GoKwik reads updated variant
    setTimeout(function () {
      if (typeof goKwikBuyNow === 'function') {
        goKwikBuyNow(btn, formSelector);
      }
    }, 50);
  };

  /**
   * AUTO-HIDE ERROR ON VARIANT CHANGE
   */
  document.addEventListener('change', function (e) {
    if (!e.target.closest('select, fieldset')) return;

    const form = e.target.closest('form[data-type="add-to-cart-form"]');
    if (!form) return;

    hideVariantError(form);
  });
})();

</script>
