<!-- SIMPL HTML CODE FOR POPUP -->
<div id="simplText" style="display: flex; align-items: center; font-size: 14px;">
  <p>
    Or 3 interest free payments of 
    <span id="priceHighlight">₹<span id="countInPaise"></span></span>
  </p>
  <img
    style="width: 15%; margin-left: 5px; margin-top: 2px;"
    src="{{ 'brand.svg' | asset_url }}"
    alt="SVG Image"
  >
  <img
    style="margin-left: 4px; margin-top: 2px; cursor: pointer;"
    onclick="openPopup()"
    src="{{ 'info.svg' | asset_url }}"
    alt="SVG Image"
  >
</div>

<!-- Overlay -->
<div id="popupOverlay" class="popup-overlay" onclick="closePopup()"></div>

<!-- Popup -->
<div id="popup" class="popup">
  <img
    class="close-icon"
    src="https://d19ud5ez64hf3q.cloudfront.net/popup/close.svg"
    id="closeButton"
    onclick="closePopup()"
  >
  <iframe
    id="simpl_iframe"
    style="width: 400px; height: 665px; border: none; padding: 0; margin: 0;"
  ></iframe>
</div>

<style>
  /* Price + ₹ styling */
  #priceHighlight {
    color: black; /* 🔴 Change this color if needed */
    font-weight: bold;
    font-size: 15px;
  }

  /* Overlay that darkens the background */
  .popup-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999999998;
  }

  /* Popup container */
  .popup {
    display: none;
    position: fixed;
    z-index: 9999999999;
    width: 400px !important;
    height: 68rem;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
    top: 52%;
    left: 65%;
    transform: translate(-50%, -50%);
    padding: 16px 0 0 0;
  }

  /* Close button styling */
  #closeButton {
    position: absolute;
    top: 40px;
    right: 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 24px;
    height: 24px;
  }
div#simplText {
    border: 1px solid #00d1c1;
    padding: 2px 10px;
    max-width: fit-content;
    border-radius: 5px;
    width: 100%;
    margin-bottom: 7px;
}
  @media only screen and (max-width: 600px) {
    .popup {
      width: 95%;
      height: auto;
      top: 50% !important;
      left: 50% !important;
    }
    #simpl_iframe {
      width: 100% !important;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  let toTal;

  try {
    let price = "{{ product.price }}";
    let priceRm = convertPaiseToRupees(price);
    toTal = priceRm;
    let count = document.querySelector("#countInPaise");

    let splitcalulate = async (data) => {
      const div = data / 3;
      const pow = Math.pow(10, 2);
      const final = Math.round(div * pow) / pow;
      const str = String(final);
      if (str.includes(".")) return (final + 0.01).toFixed(2);
      else return final;
    };

    splitcalulate(priceRm).then((value) => {
      if (count) count.innerHTML = value;
    });
  } catch (e) {
    console.log(e);
  }

  function convertPaiseToRupees(paise) {
    return paise / 100;
  }

  // Open popup function
  window.openPopup = function () {
    console.log("Popup Open Clicked");
    const iframe = document.getElementById("simpl_iframe");
    const popup = document.getElementById("popup");
    const overlay = document.getElementById("popupOverlay");

    if (iframe) {
      iframe.src = "https://d19ud5ez64hf3q.cloudfront.net/popup/index.html?price=" + toTal;
    }
    if (popup) popup.style.display = "block";
    if (overlay) overlay.style.display = "block";
  };

  // Close popup function
  window.closePopup = function () {
    console.log("Popup Closing...");
    const popup = document.getElementById("popup");
    const overlay = document.getElementById("popupOverlay");

    if (popup) popup.style.display = "none";
    if (overlay) overlay.style.display = "none";
  };
});
</script>
