{% if template contains 'collection'  %}
{% if collection.products.size > 0 %}
  <div class="comingsoon">
    <div class="inner-div">
      <div class="comingsoon-btn">
        <div id="comingBtn" class="header__icon-wrapper tap-area whatsapp_icon"
           onclick="setProductDetails('{{ collection.products[0].title }}', 
           '{{ collection.products[0].featured_image | img_url: 'master' | default: '//your-placeholder-image-url.jpg' }}')">
          Coming Soon
        </div>
      </div>
    </div>
  </div>
{% endif %}

  {% else %}
  <div class="comingsoon">
  <div class="inner-div">
    <div class="comingsoon-btn">
      <div id="comingBtn" class="header__icon-wrapper tap-area whatsapp_icon"
         onclick="setProductDetails('{{ product.title }}', 
         '{{ product.featured_image | img_url: 'master' | default: '//your-placeholder-image-url.jpg' }}')">
        Coming Soon
      </div>
    </div>
  </div>
</div>
{% endif %}


