<script>
function waitForClevertapToLoad() {
  return new Promise((resolve) => {
    const interval = setInterval(() => {
      if (window.clevertap) {
        clearInterval(interval);
        resolve();
      }
    }, 200);
  });
}

if (window.clevertap) {
  clevertap.dismissSpamControl = true; 
} else {
  waitForClevertapToLoad().then(() => {
    clevertap.dismissSpamControl = true;
  });
}

function setProductDetails(productName, productImage) {
  if (!productName) {
    console.log("Product name is missing!");
    return;
  }

  if (!productImage || productImage.includes("no-image")) {
    console.log("Image not available, using placeholder.");
    productImage = 'https://your-placeholder-image-url.jpg'; // Provide your own placeholder URL
  } else if (productImage.startsWith("//")) {
    productImage = "https:" + productImage;
  }

  console.log("Product Name: ", productName);
  console.log("Product Image URL: ", productImage);

  // Push the "Coming Soon" event to CleverTap
  const pushEventToCleverTap = () => {
    clevertap.event.push("Coming Soon Products", {
      "Product Name": productName,
      "Product Image": productImage
    });
  };

  if (window.clevertap) {
    pushEventToCleverTap();
  } else {
    waitForClevertapToLoad().then(pushEventToCleverTap);
  }
}
</script>


