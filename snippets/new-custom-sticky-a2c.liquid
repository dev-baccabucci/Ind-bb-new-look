}

/* Hide Shopify accelerated checkout */
.sticky-product-form-buttons .shopify-payment-button {
  display: none !important;
}

/* Mobile-only */
@media (min-width: 768px) {
  .sticky-product-form-buttons {
    display:none;
  }
  
  .variant-popup__content {
    max-width: 450px;
    max-height: 600px;
    border-radius: 12px;
    bottom: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: popIn 0.3s ease;
  }
  
  @keyframes popIn {
