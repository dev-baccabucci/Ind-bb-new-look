<script>
document.addEventListener('DOMContentLoaded', function() {
  const productButtons = document.querySelector('.product-form__buttons');
  if (!productButtons) return;

  // Clone sticky layout
const stickyClone = document.createElement('div');
stickyClone.classList.add('sticky-product-form-buttons');

// add wrapper for layout
const buttonWrapper = document.createElement('div');
buttonWrapper.classList.add('sticky-buttons-row');
buttonWrapper.appendChild(productButtons.cloneNode(true)); // only clone once
stickyClone.appendChild(buttonWrapper);

  // ➕ Add static payment info below sticky buttons
  const payInfo = document.createElement('div');
  payInfo.className = 'pay-img stickyone';
  payInfo.innerHTML = `
    <p>SECURE PAYMENTS</p>
    <img src="https://cdn.shopify.com/s/files/1/0279/5133/3450/files/Frame_82_762039a6-bafc-4c49-aeee-d0cafde8d43f.png?v=1758952875" width="100%" height="auto">
  `;
  stickyClone.appendChild(payInfo);

  document.body.appendChild(stickyClone);

  // Observe visibility
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        stickyClone.classList.remove('visible');
      } else {
        stickyClone.classList.add('visible');
      }
    });
  });
  observer.observe(productButtons);

  // Create popup element
  const variantPopup = document.createElement('div');
  variantPopup.className = 'variant-popup';
  variantPopup.innerHTML = `
    <div class="variant-popup__overlay"></div>
    <div class="variant-popup__content">
      <div class="variant-popup__header">
        <h3>Select Size</h3>
        <button class="variant-popup__close">&times;</button>
      </div>
      <div class="variant-popup__variants"></div>
      <div class="variant-popup__buttons">
        <button class="button button--primary variant-popup__add-to-cart">Add to Cart</button>
        <button class="button button--secondary variant-popup__buy-now">Buy Now</button>
      </div>
    </div>
  `;
  document.body.appendChild(variantPopup);

  // Elements
  const stickyAddToCart = stickyClone.querySelector('[name="add"]');
  const stickyBuyNow = stickyClone.querySelector('#gokwik-buy-now');
  const originalAddToCart = productButtons.querySelector('[name="add"]');
  const originalBuyNow = productButtons.querySelector('#gokwik-buy-now');
  
  // Popup elements
  const popupOverlay = variantPopup.querySelector('.variant-popup__overlay');
  const popupClose = variantPopup.querySelector('.variant-popup__close');
  const popupVariants = variantPopup.querySelector('.variant-popup__variants');
  const popupAddToCart = variantPopup.querySelector('.variant-popup__add-to-cart');
  const popupBuyNow = variantPopup.querySelector('.variant-popup__buy-now');

  // Helper: check if all variants selected (checks the real/original form only)
  function allVariantsSelected() {
    // Check selects
    const selects = document.querySelectorAll('.product-form__controls select');
    for (const s of selects) {
      if (!s.value) return false;
    }

    // Check radio groups by unique name
    const radioInputs = document.querySelectorAll('.product-form__controls input[type="radio"]');
    const radioNames = [...new Set(Array.from(radioInputs).map(r => r.name).filter(Boolean))];
    for (const name of radioNames) {
      const checked = document.querySelector(.product-form__controls input[type="radio"][name="${name}"]:checked);
      if (!checked) return false;
    }

    return true;
  }

  // Find size section (same as before)
  function findSizeVariantSection() {
    const variantSections = document.querySelectorAll('.product-form__controls');
    for (const section of variantSections) {
      const legend = section.querySelector('legend');
      if (legend) {
        const legendText = legend.textContent.toLowerCase();
        if (legendText.includes('size') || legendText.includes('sizes')) return section;
      }
      const groupName = section.querySelector('.product-form__group-name');
      if (groupName) {
        const groupText = groupName.textContent.toLowerCase();
        if (groupText.includes('size') || groupText.includes('sizes')) return section;
      }
    }
    return variantSections[0] || null;
  }

  // Clone & cleanup size options for popup
  function extractSizeOptions() {
    const sizeSection = findSizeVariantSection();
    if (!sizeSection) {
      console.log('No size section found');
      return null;
    }
    const sizeClone = sizeSection.cloneNode(true);

    // Keep only label part of legend/groupname
    const legend = sizeClone.querySelector('legend');
    if (legend) {
      const labelPart = legend.textContent.split(':')[0];
      legend.textContent = labelPart + ':';
    }
    const groupName = sizeClone.querySelector('.product-form__group-name');
    if (groupName) {
      const labelPart = groupName.textContent.split(':')[0];
      groupName.textContent = labelPart + ':';
    }

    return sizeClone;
  }

  // Make popup inputs independent and wire sync listeners
  function preparePopupInputsAndListeners() {
    // Radios
    const popupRadios = popupVariants.querySelectorAll('input[type="radio"]');
    popupRadios.forEach((radio, i) => {
      const origName = radio.name || '';
      const origValue = radio.value || '';
      // ensure unique id and update label 'for' inside popup
      const origId = radio.id || popup-radio-${i};
      const newId = origId + '-popup-' + Math.random().toString(36).slice(2,6);
      radio.dataset.originalName = origName;
      radio.dataset.originalValue = origValue;
      radio.id = newId;

      // update label inside popup that referenced the original id (if any)
      const lbl = popupVariants.querySelector(label[for="${origId}"]) || radio.nextElementSibling;
      if (lbl && lbl.tagName === 'LABEL') lbl.setAttribute('for', newId);

      // remove name to prevent browser grouping with page radios (this was the root cause)
      radio.removeAttribute('name');

      // add change listener to sync popup -> original
      radio.addEventListener('change', function() {
        const oName = this.dataset.originalName;
        const oValue = this.dataset.originalValue;
        if (oName) {
          const originalRadio = document.querySelector(input[type="radio"][name="${oName}"][value="${oValue}"]);
          if (originalRadio) {
            originalRadio.checked = true;
            originalRadio.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
        // ensure clicked popup radio remains visually checked (it will — no name).
        // visually highlight label (if your markup uses label + input structure, CSS :checked + label will work)
      });
    });

    // Selects (if your variant uses select dropdown)
    const popupSelects = popupVariants.querySelectorAll('select');
    popupSelects.forEach((sel, i) => {
      const origName = sel.name || '';
      sel.dataset.originalName = origName;
      const newId = (sel.id || popup-select-${i}) + '-popup-' + Math.random().toString(36).slice(2,6);
      sel.id = newId;
      sel.removeAttribute('name');
      sel.addEventListener('change', function() {
        const oName = this.dataset.originalName;
        if (oName) {
          const originalSelect = document.querySelector(select[name="${oName}"]);
          if (originalSelect) {
            originalSelect.value = this.value;
            originalSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
      });
    });

    // Sync initial selection from original form -> popup UI
    const originalChecked = document.querySelectorAll('.product-form__controls input[type="radio"]:checked');
    originalChecked.forEach(orig => {
      const popupMatch = popupVariants.querySelector(input[data-original-name="${orig.name}"][data-original-value="${orig.value}"]);
      if (popupMatch) popupMatch.checked = true;
    });
    // selects
    const originalSelects = document.querySelectorAll('.product-form__controls select');
    originalSelects.forEach(os => {
      const popupSel = popupVariants.querySelector(select[data-original-name="${os.name}"]);
      if (popupSel) popupSel.value = os.value;
    });
  }

  // Opens popup
  function openVariantPopup() {
    const sizeOptions = extractSizeOptions();
    if (sizeOptions) {
      popupVariants.innerHTML = '';
      popupVariants.appendChild(sizeOptions);

      // IMPORTANT: make popup radios/selects independent and add listeners
      preparePopupInputsAndListeners();

    } else {
      popupVariants.innerHTML = '<p style="text-align: center; padding: 20px; color: #666;">Size options not available</p>';
    }

    variantPopup.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeVariantPopup() {
    variantPopup.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Popup button handlers
  popupOverlay.addEventListener('click', closeVariantPopup);
  popupClose.addEventListener('click', closeVariantPopup);

  popupAddToCart.addEventListener('click', function() {
    if (allVariantsSelected()) {
      originalAddToCart.click();
      closeVariantPopup();
    } else {
      popupVariants.classList.add('highlight-missing');
      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);
    }
  });

  popupBuyNow.addEventListener('click', function() {
    if (allVariantsSelected()) {
      originalBuyNow.click();
      closeVariantPopup();
    } else {
      popupVariants.classList.add('highlight-missing');
      setTimeout(() => popupVariants.classList.remove('highlight-missing'), 1000);
    }
  });

  // Sticky handlers
  if (stickyAddToCart && originalAddToCart) {
    stickyAddToCart.addEventListener('click', function(e) {
      e.preventDefault();
      if (!allVariantsSelected()) openVariantPopup();
      else originalAddToCart.click();
    });
  }

  if (stickyBuyNow && originalBuyNow) {
    stickyBuyNow.addEventListener('click', function(e) {
      e.preventDefault();
      if (!allVariantsSelected()) openVariantPopup();
      else originalBuyNow.click();
    });
  }

  // Keep popup UI updated if original form changes while popup is open
  function wireOriginalToPopupSync() {
    // radios
    const originalRadios = document.querySelectorAll('.product-form__controls input[type="radio"]');
    originalRadios.forEach(r => {
      r.addEventListener('change', function() {
        if (!variantPopup.classList.contains('active')) return;
        const p = popupVariants.querySelector(input[data-original-name="${this.name}"][data-original-value="${this.value}"]);
        if (p) p.checked = true;
      });
    });
    // selects
    const originalSelects = document.querySelectorAll('.product-form__controls select');
    originalSelects.forEach(s => {
      s.addEventListener('change', function() {
        if (!variantPopup.classList.contains('active')) return;
        const p = popupVariants.querySelector(select[data-original-name="${this.name}"]);
        if (p) p.value = this.value;
      });
    });
  }
  wireOriginalToPopupSync();

  // Close popup with Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && variantPopup.classList.contains('active')) {
      closeVariantPopup();
    }
  });
});
</script>


<style>
